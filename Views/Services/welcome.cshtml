<section class="welcome-container" id="welcome-desktop">
    <h1 id="header"></h1>
    <p id="sub"></p>
</section>

<style>
    .welcome-container {
        height: 300px;
    }

    a {
        text-decoration: none;
        color: white;
    }

    #welcome-mobile {
        display: none;
    }

    #welcome-desktop {
        display: flex;
    }
</style>

<script>
    const loanId = '@(Context.Session.GetString("loan") ?? "")';
    const loanname = '@(Context.Session.GetString("loanname") ?? "")';

    $.ajax({
        url: '@Url.Action("WelcomeGet", "Home")',
        method: "GET",
        data: { id: loanId },
        success: function (response) {
     
                const data = response[0];
                $('#header').text(data.header);
                $('#sub').text(data.subContent);

                const container = $('.welcome-container');
                const imageUrl = window.innerWidth <= 768 ? data.image2 : data.image1;

                // === Preload background image ===
                const img = new Image();
                img.onload = function () {
                    container.css({
                        'background-image': `url('${imageUrl}')`,
                        'background-size': 'cover',
                        'background-position': 'center'
                    });

                    // ✅ Optionally: hide loader or fade in content
                    // $('.loader').fadeOut();
                };
                img.src = imageUrl; // <-- Missing line fixed
            }
        
    });

     
          $.ajax({
                url: "/Loan-points/" + loanId,
                method: "GET",
                success: function (response) {
                    console.log(response);
                       $('.gold-features').empty();
                    const data = response.data;
                    data.forEach(function(item){
                     $('.gold-features').append(` <div class="feature">
        <img src="/images/icon/checklist.png" alt="">
        <span>${item.point}</span>
    </div>`);
                    });
                  
                }
            });
            
            $.ajax({
                url: '@Url.Action("GetLoancontent", "Home")',
                method : "GET",
                data:{Id:loanId},
                success:function(response){
                       var content = response[0].content;
                   $('#item-para').text(content);
                }
            });
                  $.ajax({
        url: '@Url.Action("Offers", "Home")',
        method: "GET",
        data: { Id: loanId },
        success: function (response) {
            console.log("Offers:", response);

            if (response && response.length > 0) {
                response.forEach(function(item) {
                    // Example: add to your .gold-features div
                    $(".right").append(`
                   <div class="card-item">
                <div class="card-content">
                <h3>${item.offerHeader} </h3>

                   <p>
                        <i class="fas fa-check-circle"></i>
                        <span>   ${item.offerContent}</span>
                    </p>
               </div>
        </div>


                    `);
                });
            } else {
                console.warn("No offers found.");
            }
        },
        error: function (xhr) {
            console.error("Error fetching offers:", xhr.responseText);
        }
    });

           
    
            
</script>
