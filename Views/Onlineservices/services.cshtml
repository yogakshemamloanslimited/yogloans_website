    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);
        const loanStatus = urlParams.get('loan');
        if (loanStatus === 'notfound') {
            Swal.fire({
                icon: 'error',
                title: 'No Loan Found',
                text: 'No loan found for the provided details.'
            });
        }
    });


