            const mobileNo = $('#mobileNo4').val();
            $('#spin-load4').show();
            $('#taxFormMsg4').text('');
            $.ajax({
                url: API.allapi.verifyDetails,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ CustomerId: customerId, MobileNo: mobileNo }),
                success: function (res) {
                    if (res.success) {
                        slNo = res.slNo;
                        $('#otpSection4').show();
                        $('#sendOtpBtn4').hide();
                        $('#spin-load4').hide();
                        $('#taxFormMsg4').text(res.message).css('color', 'green');
                    } else {
                        $('#taxFormMsg4').text(res.message || 'Failed to send OTP').css('color', 'red');
                        $('#spin-load4').hide();
                    }
                },
                error: function (xhr) {
                    $('#taxFormMsg4').text(xhr.responseText || 'Error occurred').css('color', 'red');
                    $('#spin-load4').hide();
                }
            });
        });

        $('#verifyOtpBtn4').on('click', function (e) {
            e.preventDefault();

            const customerId = $('#customerId4').val();
            const mobileNo = $('#mobileNo4').val();
            const otp = $('#otpInput4').val();
            $('#spin-very-load4').show();
            if (!slNo) {
                $('#taxFormMsg4').text('Session expired. Please try again.').css('color', 'red');
                return;
            }
            $.ajax({
                url: API.allapi.verifyotp,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ CustomerId: customerId, MobileNo: mobileNo, Otp: otp, SlNo: slNo }),
                success: function (res) {
                    $('#spin-very-load4').hide();
                    var url = API.allapi.onlineCustomer;
                    alert(url);
                    if (res.success) {
                        $.get(`${url}${encodeURIComponent(customerId)}&mobileNo=${encodeURIComponent(mobileNo)}`,
                            function (apiRes) {
                                console.log("API Response:", apiRes);
                                var customerAddress = "";
                                if (apiRes.customer_data && apiRes.customer_data.length > 0) {
                                    customerAddress = apiRes.customer_data[0].email_id;
                                    console.log("Customer Address:", customerAddress);
                                }


                                const flag = apiRes.message.slice(0, 2); // '$a'
                                const userMessage = apiRes.message.slice(3); // Remove flag + space

                                if (flag === "$b") {
                                    Swal.fire({
                                        title: '<span style="color:orange;">⏰ Wait!</span>',
                                        html: userMessage,
                                        showConfirmButton: true
                                    }).then((result) => {

                                            if (result.isConfirmed || result.isDismissed) {

                                            $('#qrCodeModal').modal("hide");
                                            $('#taxForm4')[0].reset();
                                            $('#otpSection4').hide();
                                            $('#sendOtpBtn4').show();
                                            $('#taxFormMsg4').text('');

                                            return;
                                        }
                                    });

                                    return;
                                }

                                

                                $.ajax({
                                    url: '@Url.Action("Customeraddress", "Home")',
                                    type: "POST",
                                    xhrFields: { withCredentials: true },
                                    data: {
                                        address: customerAddress,
                                        CustomerId: customerId
                                    },
                                    success: function (res) {
                                        console.log("Session set response:", res);
                                        if (res.success) {
                                            // Delay slightly to ensure session cookie is persisted
                                            setTimeout(() => {
                                                window.location.href = `/Generateqrcode`;
                                            }, 300);
                                        }
                                    },
                                    error: function (err) {
                                        console.error("Session set failed:", err);
                                    }
                                });
                            }
                        );
                        // Optionally close modal or reset form
                    }

                    else {
                        $('#taxFormMsg4').text('OTP verification failed').css('color', 'red');
                        $('#spin-very-load4').hide();
                    }
                },
                error: function (xhr) {
                    $('#taxFormMsg4').text(xhr.responseText || 'Error occurred').css('color', 'red');
                    $('#spin-very-load4').hide();
                }
            });
        });

        $('#resendOtpBtn4').on('click', function (e) {
            e.preventDefault();

            const customerId = $('#customerId4').val();
            const mobileNo = $('#mobileNo4').val();

            $('#spin-load4').show();
            if (!slNo) {
                $('#taxFormMsg4').text('Session expired. Please try again.').css('color', 'red');
                return;
            }
            $.ajax({
                url: API.allapi.resendOtp,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ CustomerId: customerId, MobileNo: mobileNo, SlNo: slNo }),
                success: function (res) {
                    if (res.success) {
                        $('#spin-load4').hide();
                        $('#taxFormMsg4').text(res.message).css('color', 'green');
                    } else {
                        $('#spin-load4').hide();
                        $('#taxFormMsg4').text(res.message || 'Failed to resend OTP').css('color', 'red');
                    }
                },
                error: function (xhr) {
                    $('#spin-load4').hide();
                    $('#taxFormMsg4').text(xhr.responseText || 'Error occurred').css('color', 'red');
                }
            });
        });
