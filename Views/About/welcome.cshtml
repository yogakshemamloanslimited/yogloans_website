@model List<yogloansdotnet.Models.AboutWelcome>
 

    @{
    var firstWelcome = Model?.FirstOrDefault();
    string imageBase64 = firstWelcome?.Image1 != null
? "data:image/png;base64," + Convert.ToBase64String(firstWelcome.Image1)

: null;
    string image2Base64 = firstWelcome?.Image2 != null
    ? "data:image/png;base64," + Convert.ToBase64String(firstWelcome.Image2)
    : null;
    }
<!-- Desktop/Tablet Section (Image1) -->
<section class="welcome-container"
         style="background-image: url(@(imageBase64 ?? ""))" id="welcome-desktop">
    <h1 id="header" style="visibility:hidden;">About Us</h1>
    <div class="button">
        <h1 id="header">About Us</h1>
        @* <p><a href="javascript:history.back()" id="return-link">Home</a> - About Us</p> *@
    </div>
</section>

<!-- Mobile Section (Image2) -->
<section class="welcome-container"
         style="background-image: url(@(image2Base64 ?? ""))" id="welcome-mobile">
    <h1 id="header" style="visibility:hidden;">About Us</h1>
    <div class="button">
        <h1 id="header">About Us</h1>
        @* <p><a href="javascript:history.back()" id="return-link">Home</a> - About Us</p> *@
    </div>
</section>

<style>
    .welcome-container{
        height: 300px;
    }
    a{
        text-decoration:none;
        color:white;
    }
    #welcome-mobile { display: none; }
    #welcome-desktop { display: flex; }
    @@media (max-width: 767px) {
        #welcome-desktop { display: none; }
        #welcome-mobile { display: flex; }
    }
</style>


