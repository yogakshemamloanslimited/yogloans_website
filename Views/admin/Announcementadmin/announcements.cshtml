<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="col-12" style="display:flex; justify-content: end; gap:20px;">
                        <!-- <button type="button" class="btn btn-primary" onclick="window.location.href='/admin/Careeradmin/departments'">Add Departments +</button> -->
                        <!--                         <button type="button" class="btn btn-primary" onclick="window.location.href='/admin/Careeradmin/designation'">Add Designation +</button> -->
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add-ann" onclick="addclear()">Add Announcements +</button>

                        <!--                         <button type="button" class="btn btn-primary" onclick="window.location.href='/admin/homeloan/offer'">Add Offer +</button> -->
                    </div>

                    <div class="table-responsive mt-3">
                        <table id="loansTable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>title</th>
                                    <th> banner</th>
                                    <th>content show</th>
                                   
                                   
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                           
                                @{
                                    int count = 1;
                                }
                                @foreach (var data in Model)
                                {
                                    var imgBase64 = data.image != null ? "data:image/png;base64," + Convert.ToBase64String(data.image) : "";

                                    <tr>
                                        <td>@count</td>
                                        <td>@data.title</td>
                                        <td style="cursor:pointer;">
                                            @if (data.image != null)
                                            {
                                                <img src="@imgBase64"
                                                     style="width:100px; height:50px; object-fit:contain; cursor:pointer;"
                                                     onclick="showImagePopup('@imgBase64')" />
                                            }
                                        </td>
                                        <td style="cursor:pointer;" onclick='showContent("@data.content")'>
                                            <i class="fa fa-eye"></i>
                                        </td>
                                        <td style="display:flex; gap:10px;">
                                            <button class="btn btn-sm btn-warning"
                                                    onclick='editAnnouncement("@data.Id", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data.title)), "@imgBase64", "@data.content")'>
                                                Edit
                                            </button>
                                            <button class="btn btn-sm btn-danger" onclick="deleteAnnouncement(@data.Id)">Delete</button>
                                        </td>
                                    </tr>
                                    count++;
                                }


                            </tbody>
                       </table>
                         </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="add-ann" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Announcements</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

            </div>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            } 
            <div class="model-body" style="padding: 40px;">
                <form id="myForm"
                      action="/admin/Announcementadmin/add-aanouncements"
                      method="post"
                      enctype="multipart/form-data"
                      class="col-12"
                      style="display:flex; flex-direction:column; gap:20px; justify-content:center; align-items:center;">

                      <input type="hidden" value="" name="id" id="id">

                    <!-- TITLE -->
                    <div class="col-12">
                        <p>Title</p>
                        <input type="text" name="title" id="title" class="form-control" placeholder="Enter Title" required />
                    </div>

                    <img src="" id="image" style="width:100%; height:250px; object-fit:contain; display:none; " />

                    <!-- PDF UPLOAD -->
                    <div class="col-12">
                        <p>Upload PDF</p>
                        <input type="file" name="ImageFile" class="form-control" accept="image/*" required />
                    </div>



                    <!-- ANNOUNCEMENT CONTENT (FROALA) -->
                    <div class="col-12">
                        <p>Announcement Content</p>

                        <!-- Froala Editor Textarea (DO NOT GIVE NAME HERE) -->
                        <textarea id="edit" class="form-control" rows="5" style="height:600px;"></textarea>

                        <!-- Hidden input (THIS sends encrypted content to backend) -->
                        <input type="hidden" id="encryptedContent" name="content" />
                    </div>



                    <!-- SUBMIT BUTTON -->
                    <div class="col-12" style="text-align:center;">
                        <button type="submit" class="btn btn-primary" id="sb-btn">Create Announcement</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <img id="popupImage" src="" style="max-width:100%; max-height:500px;" />
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="contentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Announcement Content</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent" style="max-height: 70vh; overflow-y: auto;">
                <!-- Decrypted content will be inserted here -->
            </div>
        </div>
    </div>
</div>

