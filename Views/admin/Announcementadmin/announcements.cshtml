<script>

    var editorInstance;

    // Convert any FILE (image/video) to Base64
    function fileToBase64(file, callback) {
        const reader = new FileReader();
        reader.onload = function (e) {
            callback(e.target.result);
        };
        reader.readAsDataURL(file);
    }

    // Convert <img> tag src to Base64
    function convertImageToBase64($img) {
        if ($img.attr('src').startsWith('data:')) return;

        fetch($img.attr('src'))
            .then(res => res.blob())
            .then(blob => {
                fileToBase64(blob, function (base64) {
                    $img.attr('src', base64);
                });
            });
    }

    // Convert <video> tag src to Base64
    function convertVideoToBase64($video) {
        if ($video.attr('src').startsWith('data:')) return;

        fetch($video.attr('src'))
            .then(res => res.blob())
            .then(blob => {
                fileToBase64(blob, function (base64) {
                    $video.attr('src', base64);
                });
            });
    }


    // Initialize Froala
    new FroalaEditor('#edit', {

        imageUpload: true,      // allow local image upload
        videoUpload: true,      // allow local video upload
        fileUpload: false,      // you don’t need this

        // prevent actual server upload
        imageUploadURL: null,
        videoUploadURL: null,

        events: {

            initialized: function () {
                editorInstance = this;
            },

            // When image is uploaded (local)
            'image.beforeUpload': function (files) {
                const editor = this;

                fileToBase64(files[0], function (base64) {
                    editor.image.insert(base64, null, null, editor.image.get());
                });

                return false; // stop server upload
            },

            // When video is uploaded (local)
            'video.beforeUpload': function (files) {
                const editor = this;

                fileToBase64(files[0], function (base64) {
                    editor.video.insert(base64, null, null, editor.video.get());
                });

                return false; // stop server upload
            },

            // When pasting HTML content containing images/videos
            'paste.after': function () {

                $('#edit img').each(function () {
                    convertImageToBase64($(this));
                });

                $('#edit video').each(function () {
                    convertVideoToBase64($(this));
                });
            }
        }

    });


    // Encrypt on submit
    $('#myForm').on('submit', function () {

        var content = editorInstance.html.get();
        var key = "MySecretKey12345";

        var encrypted = CryptoJS.AES.encrypt(content, key).toString();

        $('#encryptedContent').val(encrypted);
    });
     function showImagePopup(base64) {
        $('#popupImage').attr('src', base64);
        var modal = new bootstrap.Modal(document.getElementById('imageModal'));
        modal.show();
    }
       function showContent(encryptedContent) {
        var key = "MySecretKey12345";
        var decrypted = CryptoJS.AES.decrypt(encryptedContent, key).toString(CryptoJS.enc.Utf8);

        // Inject decrypted HTML into modal
        document.getElementById("modalContent").innerHTML = decrypted;

        // Show Bootstrap modal
        var modal = new bootstrap.Modal(document.getElementById("contentModal"));
        modal.show();
    }

           function editAnnouncement(id, title, image, encryptedContent) {
                 $('#image').attr('src', '');
                 $('#sb-btn').text('');
                 $('#sb-btn').text('Edit Announcement');
                 
        // Show modal
        var modal = new bootstrap.Modal(document.getElementById('add-ann'));
        modal.show();

        // Set hidden ID field
                $('#id').val('');

        $('#id').val(id);

        // Set title input
         $('#title').val('');
        $('#title').val(title);

        // Set image preview
         $('#image').show();
        $('#image').attr('src', image);
        
        // Wait for Froala editor to be initialized
        var checkEditor = setInterval(function () {
            if (editorInstance) {
                clearInterval(checkEditor);

                // Decrypt content
                var key = "MySecretKey12345";
                var decrypted = CryptoJS.AES.decrypt(encryptedContent, key).toString(CryptoJS.enc.Utf8);

                // Set Froala editor content
                editorInstance.html.set(decrypted);
            }
        }, 100);
    }
    function addclear() {
              $('#sb-btn').text('');
                 $('#sb-btn').text('Create Announcement');
        // Clear all text inputs
        $('#myForm').find('input[type="text"], input[type="file"], input[type="hidden"]').val('');

        // Clear image preview
        $('#image').attr('src', '');
            $('#image').hide();
        // Clear Froala editor content
        if (editorInstance) {
            editorInstance.html.set('');
        }
    }
     function deleteAnnouncement(id) {
         alert(id);
        if (!confirm("Are you sure you want to delete this announcement?")) return;

        $.ajax({
            url: '/admin/Announcementadmin/deleteannoun', // make sure path matches your controller
            type: 'POST',
            data: { id: id },
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            success: function () {
                alert("Announcement deleted successfully!");
                location.reload(); // reload page to update table
            },
            error: function () {
                alert("Error deleting announcement. Try again.");
            }
        });
    }


</script>

