
 @model yogloansdotnet.Models.HomwelcomeModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/admin/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                      <p>Home - Welcome section</p>
                </div>
                <div class="card-body">
                  

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
</div>
</div>
</div></div>
</div>

<style>
    .loader-mask {
        display: none;
    }

    footer {
        display: none;
    }

    .card {
        margin-top: 20px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        border: none;
        border-radius: 10px;
    }

    .card-body {
        padding: 2rem;
    }

    .card-title {
        color: #1e293b;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .card-text {
        color: #64748b;
    }

    .alert {
        margin-bottom: 20px;
    }

    .text-danger {
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
        color: #dc3545;
    }

    .form-control {
        margin-bottom: 0.5rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

    .image-upload-group {
        margin-bottom: 1rem;
    }

        .image-upload-group .text-danger {
            margin-top: 0.5rem;
        }
</style>


<script>
        $(document).ready(function () {
        $.ajax({
            url: "/loans",
            method: "GET",
            success: function (response) {
                console.log(response);

                const container = $('.card-body');
                container.empty(); // clear old content

                if (Array.isArray(response) && response.length > 0) {
                    response.forEach(function (item, index) {
                        const formId = `loanForm-${index}`;
                        const formHtml = `
                            <div class="loan-section mb-4 p-3 border rounded">
                                <h5 class="text-primary">${item.loanname || 'Loan ' + (index + 1)}</h5>

                                <!-- ✅ Use ASP.NET MVC controller/action -->
                                <form class="col-12 loan-form"
                                      id="${formId}"
                                      asp-controller="Home"
                                      asp-action="welcomecreate"
                                      method="post"
                                      enctype="multipart/form-data">

                                        @Html.AntiForgeryToken()
                                    <input type="hidden" name="LoanType" value="${item.LoanType || ''}" />
                                    <input type="hidden" name="loan_id" value="${item.id}" class="loan-id">
                                    <div class="row g-3 mt-2">
                                        <!-- Image 1 -->
                                           <!-- Image 1 -->
    <div class="col-md-6">
        <div class="image-upload-group">
            <label class="card" style="display:flex;justify-content:center;align-items:center;height:300px;cursor:pointer;position:relative;overflow:hidden;">
                <input type="file" name="Image1" id="upload1-${index}" accept="image/*" style="width:100%;height:100%;position:absolute;visibility:hidden;">
                <img id="placeholder1-${index}" src="~/images/icon/image.png" style="width:80px;height:80px;opacity:0.1;position:absolute;z-index:1;">
                <img id="preview1-${index}" src="${item.Image1 || ''}" style="${item.Image1 ? 'width:100%;height:100%;object-fit:cover;position:absolute;z-index:0;' : 'display:none;'}">
            </label>
        </div>
    </div>


                                        <!-- Image 2 -->
                                        <div class="col-md-6">
                                            <div class="image-upload-group">
                                                <label class="card" for="upload2-${index}"
                                                    style="display:flex;justify-content:center;align-items:center;height:300px;cursor:pointer;position:relative;overflow:hidden;">
                                                    <input type="file" name="Image2" id="upload2-${index}" accept="image/*"
                                                        style="width:100%;height:100%;position:absolute;visibility:hidden;">
                                                    <img id="placeholder2-${index}" src="images/icon/image.png"
                                                        style="width:80px;height:80px;opacity:0.1;position:absolute;z-index:1;">
                                                    <img id="preview2-${index}" src="${item.Image2 || ''}"
                                                        style="${item.Image2 ? 'width:100%;height:100%;object-fit:cover;position:absolute;z-index:0;' : 'display:none;'}">
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Text fields -->
                                        <div class="col-12">
                                            <div class="form-group mb-3">
                                                <label for="header-${index}">Main Header</label>
                                                <input class="form-control" name="Header" id="header-${index}"
                                                    value="${item.Header || ''}" placeholder="Enter main header">
                                                <span class="text-danger small" id="headerError-${index}"></span>
                                            </div>

                                            <div class="form-group mb-3">
                                                <label for="content-${index}">Sub Content</label>
                                                <textarea class="form-control" name="SubContent" id="content-${index}"
                                                    placeholder="Enter sub content" rows="4">${item.SubContent || ''}</textarea>
                                                <span class="text-danger small" id="contentError-${index}"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100 mt-2"
                                        style="background-color:#044697;border:none;">Save ${item.loanname || 'Loan'}</button>
                                </form>
                            </div>
                        `;

                        container.append(formHtml);
           
        const loanId = item.id; // from your /loans loop
    $.ajax({
        url: "/Admin/welcomeget",
        method: "GET",
        data: { id: loanId },
        success: function(response) {
            if (Array.isArray(response) && response.length > 0) {
                const welcomeItem = response[0]; // first record for this loan

                console.log("Populating form for loan", loanId, welcomeItem);

                // Find the correct form by loan_id
                const form = $(`.loan-form input[name='loan_id'][value='${loanId}']`).closest('form');

                // Fill header & subContent
                form.find("input[name='Header']").val(welcomeItem.header || '');
                form.find("textarea[name='SubContent']").val(welcomeItem.subContent || '');

                // Fill images if they exist
                if (welcomeItem.image1) {
                    form.find("img[id^='preview1']").attr('src', welcomeItem.image1).show();
                    form.find("img[id^='placeholder1']").hide();
                }
                if (welcomeItem.image2) {
                    form.find("img[id^='preview2']").attr('src', welcomeItem.image2).show();
                    form.find("img[id^='placeholder2']").hide();
                }
            } else {
                console.log("No welcome data found for loan", loanId);
            }
        },
        error: function(err) {
            console.error("Error fetching welcome data for loan", loanId, err);
        }
    });

          
                        // ✅ Setup image uploads
                        setupImageUpload(`upload1-${index}`, `preview1-${index}`, `placeholder1-${index}`);
                        setupImageUpload(`upload2-${index}`, `preview2-${index}`, `placeholder2-${index}`);

                        // ✅ Handle form submit (AJAX or normal post)
                        $(`#${formId}`).on('submit', function (e) {
                            e.preventDefault();

                            if (!validateForm(index)) return;

                            const formData = new FormData(this);

                            $.ajax({
                                url: '/Home/welcomecreate',
                                method: 'POST',
                                data: formData,
                                processData: false,
                                contentType: false,
                                success: function (res) {
                                    Swal.fire({
                                        title: 'Saved Successfully!',
                                        text: 'Loan details have been updated.',
                                        imageUrl: '/images/icon/sign-up.png',
                                        imageWidth: 80,
                                        imageHeight: 80,
                                        confirmButtonColor: '#044697',
                                        confirmButtonText: 'OK'
                                    }).then(() => {
        window.location.reload(); // ✅ reloads the page
    });
                                },
                                error: function (err) {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error!',
                                        text: 'Something went wrong while saving.',
                                        confirmButtonColor: '#B4181E'
                                    });
                                    console.error(err);
                                }
                            });
                        });
                    });
                } else {
                    container.html('<p class="text-center text-muted">No loan data found.</p>');
                }
            },
            error: function (xhr) {
                console.error(xhr);
                $('.card-body').html('<p class="text-danger text-center">Error fetching loan data.</p>');
            }
        });
    });


    // ✅ Helper: Image preview
    function setupImageUpload(uploadId, previewId, placeholderId) {
        const input = document.getElementById(uploadId);
        const preview = document.getElementById(previewId);
        const placeholder = document.getElementById(placeholderId);

        if (!input) return;
        input.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    placeholder.style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        });
    }


    // ✅ Helper: Validation
    function validateForm(index) {
        const header = document.getElementById(`header-${index}`);
        const content = document.getElementById(`content-${index}`);
        const headerError = document.getElementById(`headerError-${index}`);
        const contentError = document.getElementById(`contentError-${index}`);
        let isValid = true;

        headerError.textContent = '';
        contentError.textContent = '';

        if (!header.value.trim()) {
            headerError.textContent = 'Header is required';
            isValid = false;
        }

        if (!content.value.trim()) {
            contentError.textContent = 'Sub content is required';
            isValid = false;
        }

        return isValid;
    }
   
</script>