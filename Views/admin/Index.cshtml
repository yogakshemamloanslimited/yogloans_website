
 @model yogloansdotnet.Models.HomwelcomeModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/admin/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                      <p>Home - Welcome section</p>
                </div>
                <div class="card-body">
                  

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
</div>
</div>
</div></div>
</div>

<style>
    .loader-mask {
        display: none;
    }

    footer {
        display: none;
    }

    .card {
        margin-top: 20px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        border: none;
        border-radius: 10px;
    }

    .card-body {
        padding: 2rem;
    }

    .card-title {
        color: #1e293b;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .card-text {
        color: #64748b;
    }

    .alert {
        margin-bottom: 20px;
    }

    .text-danger {
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
        color: #dc3545;
    }

    .form-control {
        margin-bottom: 0.5rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

    .image-upload-group {
        margin-bottom: 1rem;
    }

        .image-upload-group .text-danger {
            margin-top: 0.5rem;
        }

    .image1{
        object-fit: contain !important;
        position: absolute !important;
        height: 100% !important;
        width: 100% !important;
    }
    
    
</style>
<script>
    $(document).ready(function () {

        $.ajax({
            url: "/loans",
            method: "GET",
            success: function (response) {

                const container = $('.card-body');
                container.empty();

                if (!Array.isArray(response) || response.length === 0) {
                    container.html("<p class='text-center'>No loan data found.</p>");
                    return;
                }

                response.forEach((item, index) => {

                    let img1 = item.Image1 ? "data:image/png;base64," + item.Image1 : "";
                    let img2 = item.Image2 ? "data:image/png;base64," + item.Image2 : "";

                    const formId = `loanForm-${index}`;

                    const html = `
    <div class="loan-section mb-4 p-3 border rounded">
        <h5 class="text-primary">${item.loanname}</h5>

        <form id="${formId}"
              class="loan-form"
              action="/Home/welcomecreate"
              method="post"
              enctype="multipart/form-data">

            <input type="hidden" name="__RequestVerificationToken" value="@@token" />
            <input type="hidden" name="loan_id" value="${item.id}" />
            <input type="hidden" name="Id" value="0" /> <!-- will be updated later -->

            <div class="row g-3">

                                                         <!-- Image 1 -->
    <div class="col-md-6">
        <div class="image-upload-group">
            <label class="card" style="display:flex;justify-content:center;align-items:center;height:300px;cursor:pointer;position:relative;overflow:hidden;">
                <input type="file" name="Image1" id="upload1-${index}" accept="image/*" style="width:100%;height:100%;position:absolute;visibility:hidden;">
                <img id="placeholder1-${index}" src="images/icon/image.png" style="width:80px;height:80px;opacity:0.1;position:absolute;z-index:1;">
                <img id="preview1-${index}" src="${img1 || ''}" style="${img1 ? 'width:100%; height:100%; object-fit:contain; position:absolute;z-index:0;' : 'display:none;'}" class="image1">
            </label>
        </div>
    </div>


                                        <!-- Image 2 -->
                                        <div class="col-md-6">
                                            <div class="image-upload-group">
                                                <label class="card" for="upload2-${index}"
                                                    style="display:flex;justify-content:center;align-items:center;height:300px;cursor:pointer;position:relative;overflow:hidden;">
                                                    <input type="file" name="Image2" id="upload2-${index}" accept="image/*"
                                                        style="width:100%;height:100%;position:absolute;visibility:hidden;">
                                                    <img id="placeholder2-${index}" src="images/icon/image.png"
                                                        style="width:80px;height:80px;opacity:0.1;position:absolute;z-index:1;">
                                                    <img id="preview2-${index}" src="${img1 || ''}"
                                                        style="${img2 ? 'width:100%;height:100%;object-fit:contain;position:absolute;z-index:0;' : 'display:none;'}" class="image1">
                                                </label>
                                            </div>
                                        </div>
                <!-- Header -->
                <div class="col-12">
                    <label>Main Header</label>
                    <input class="form-control" name="Header" id="header-${index}" value="" />
                    <span class="text-danger" id="headerError-${index}"></span>
                </div>

                <!-- Sub Content -->
                <div class="col-12">
                    <label>Sub Content</label>
                    <textarea class="form-control" name="SubContent" id="content-${index}" rows="4"></textarea>
                    <span class="text-danger" id="contentError-${index}"></span>
                </div>

            </div>

            <button class="btn btn-primary w-100 mt-3">Save ${item.loanname}</button>
        </form>
    </div>
    `;

                    container.append(html);

                    // Add image preview
                    setupImageUpload(`upload1-${index}`, `preview1-${index}`, `placeholder1-${index}`);
                    setupImageUpload(`upload2-${index}`, `preview2-${index}`, `placeholder2-${index}`);

                    // Load existing welcome data
                    loadWelcomeData(item.id, index);

                    // Handle form submit
                    setupFormSubmit(formId, index);
                });
            }
        });

    });


    // ===============================
    // Load Existing Welcome Data
    // ===============================
    function loadWelcomeData(loanId, index) {

        $.get("/Admin/welcomeget", { id: loanId }, function (data) {

            if (!Array.isArray(data) || data.length === 0) return;

            const w = data[0];
            const form = $(`input[name='loan_id'][value='${loanId}']`).closest("form");

            // Fill ID for update
            form.find("input[name='Id']").val(w.id);

            // Fill text
            form.find("input[name='Header']").val(w.header || "");
            form.find("textarea[name='SubContent']").val(w.subContent || "");

            // Fill images
            if (w.image1) {
                const img = "data:image/png;base64," + w.image1;
                $(`#preview1-${index}`).attr("src", img).show();
                $(`#placeholder1-${index}`).hide();
            }

            if (w.image2) {
                const img = "data:image/png;base64," + w.image2;
                $(`#preview2-${index}`).attr("src", img).show();
                $(`#placeholder2-${index}`).hide();
            }

        });
    }


    // ===============================
    // Image Upload Preview
    // ===============================
    function setupImageUpload(inputId, previewId, placeholderId) {
        $("#" + inputId).on("change", function () {
            const file = this.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                $("#" + previewId).attr("src", e.target.result).show();
                $("#" + placeholderId).hide();
            };
            reader.readAsDataURL(file);
        });
    }


    // ===============================
    // Form Submit Handler
    // ===============================
    function setupFormSubmit(formId, index) {

        $("#" + formId).submit(function (e) {
            e.preventDefault();

            if (!validateForm(index)) return;

            const formData = new FormData(this);

            $.ajax({
                url: "/Home/welcomecreate",
                method: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function () {
                    Swal.fire({
                        title: "Saved!",
                        text: "Data updated successfully",
                        icon: "success",
                        confirmButtonColor: "#044697"
                    }).then(() => location.reload());
                },
                error: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "Failed to save"
                    });
                }
            });
        });
    }


    // ===============================
    // Validation
    // ===============================
    function validateForm(index) {

        const header = $(`#header-${index}`);
        const content = $(`#content-${index}`);

        let ok = true;

        if (!header.val().trim()) {
            $(`#headerError-${index}`).text("Header is required");
            ok = false;
        } else {
            $(`#headerError-${index}`).text("");
        }

        if (!content.val().trim()) {
            $(`#contentError-${index}`).text("Sub content is required");
            ok = false;
        } else {
            $(`#contentError-${index}`).text("");
        }

        return ok;
    }

</script>
