      function addpay(no, product, due_amount) {
        // Check if the loan number already exists in the table
        let exists = false;
        $('#table-fill tr').each(function() {
            // The first cell in each row contains the loan number
            let loanNo = $(this).find('td:first').text();
            if (loanNo === no) {
                exists = true;
                return false; // break loop
            }
        });

        if (exists) {
           
            $('#result').empty();
              $('#result').hide();
            $('#field_error').text('This loan number is already added.').css('color', 'red');
            return;
        }

        $('#table-fill').show();
        $('#total-amount-card').show();
        var amount = $('#amount').val();
        $('#table-fill').append(
            `
            <tr>
                <td>${no}</td>
                <td>${product}</td>
                <td>${due_amount}</td>
                <td class="amount-pay">${amount}</td>
                <input value="${no}" name="loan_no" type="hidden" id="loanNo">
                <input value="${amount}" name="pay_amount" type="hidden" id="pay_amount"> 
                <td><button class="btn btn-danger btn-sm remove-row">Remove</button></td>
            </tr>
            `
        );
        updateTotalPay();
        $('#result').empty();
         $('#result').hide();
        $('#loaninput').val('');
    }

    // Remove row on button click
    $('#table-fill').on('click', '.remove-row', function () {
        $(this).closest('tr').remove();
        if ($('#table-fill tr').length === 1) {
            $('#table-fill').hide();
        }
        updateTotalPay();
        var totalvalue = $('#totalpay').text(); // ✅ removed extra parenthesis
totalvalue = parseFloat(totalvalue); // convert to number if needed

if (totalvalue > 0) {
    $('#total-amount-card').show();
} else {
    $('#total-amount-card').hide();
}

    });


    $(document).ready(function () {
        if ($('#table-fill tr').length === 1) {
            $('#table-fill').hide();
        }
    });

    function updateTotalPay() {
        let total = 0;
        $('.amount-pay').each(function() {
            let val = parseFloat($(this).text());
            if (!isNaN(val)) {
                total += val;
            }
        });
        $('#totalpay').text(total.toFixed(2));
    }

 $('#loanTable').on('submit', function (e) {
    e.preventDefault();

    var requestData = {
    CustomerId: $('#customerId').val(),
    CustomerName: $('#customerName').val(),
    CustomerMobile: $('#mobile').val(), // Assuming mobile is the customer's mobile number
    Amount: parseFloat($('#amount').val()), // This is the total amount for all payments
    GridRows: []
};

// Suppose you loop through table rows to collect loan/payment info:
$('#table-fill tr').each(function() {
    var loanNo = $(this).find('td:first').text(); // Assuming loan number is in the first column
    var payAmount = $(this).find('.amount-pay').text(); // Assuming payment amount is in the last column
    if (loanNo && payAmount) {
        requestData.GridRows.push({
            LoanNo: parseInt(loanNo),
            PayAmount: parseFloat(payAmount)
        });
    }
});

   
    $.ajax({
        url: API.allapi.Careerpay,
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(requestData),
        success: function (response) {
            console.log(response);
            alert("Order No: " + response.orderNo + "\nPayment URL Data: " + response.paymentData);
        },
        error: function (xhr, status, error) {
            console.error(xhr.responseText);
            alert("Failed: " + xhr.responseText);
        }
    });
});

 $(document).ready(function () {
    // Get session string from Razor
    var sessionaddress = '@Context.Session.GetString("Customeraddress")';
    var sessionaCustomerId = '@Context.Session.GetString("CustomerId")';


    document.getElementById('customerId').value = sessionaCustomerId;

    if (sessionaddress && sessionaddress !== "null" && sessionaddress.trim() !== "") {
        // Split into parts by '$'
        var part = sessionaddress.split('$').map(p => p.trim());

        // Debug log
        console.log("Address Parts:", part);

        // Fill main display (summary)
        $('#address').html(`${part[1]}, ${part[2]}, ${part[3]} - ${part[5]} ${part[4]}`);
        $('#customerName').text(part[0] || '');
        $('#customer_name').text('Hello: ' + (part[0] || ''));
        $('#mobile').text(part[6] || '');
        // Fill separate fields if they exist in HTML
    @*     $('#name').val(part[0] || '');
        $('#house').val(part[1] || '');
        $('#city').val(part[2] || '');
        $('#state').val(part[3] || '');
        $('#country').val(part[4] || '');
        $('#pincode').val(part[5] || '');
        $('#phone').val(part[6] || '');
        $('#email').val(part[7] || ''); *@
    } else {
        $('#address').text("No address found in session.");
    }
    
});

