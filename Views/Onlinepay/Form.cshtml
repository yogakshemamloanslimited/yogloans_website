 $(document).ready(function () {
    $('#loaninput').on('input', function () {
        let loanno = $(this).val().trim();

        // Only allow digits
        loanno = loanno.replace(/\D/g, '');
        $(this).val(loanno);

        const customerId = $('#customerId').val(); // get customerId

        // Clear previous result
        $('#result').empty();
        $('#field_error').text('');

        // Check for empty input
        if (!loanno) {
            $('#field_error').text('Loan number is required.').css('color', 'red');
            return;
        }

        // Optional: minimum length for validation (e.g., 6 digits)
        if (loanno.length < 10) {
            $('#field_error').text('Loan number must be at least 10 digits.').css('color', 'red');
            return;
        }

        if (!customerId) {
            $('#field_error').text('Customer ID is missing.').css('color', 'red');
            return;
        }

        // Show loader
        $('#load').show();
        $('#fa').hide();

        // AJAX to validate loan number
        $.ajax({
            url: API.allapi.Payonline + encodeURIComponent(customerId) + '/' + encodeURIComponent(loanno),
            method: 'GET',
            success: function (response) {
                $('#load').hide();
                $('#fa').show();
                $('#result').empty();
                    $('#result').show();
                if (response && response.customer_data && response.customer_data.length > 0) {
                    const customer = response.customer_data[0];
                    $('#field_error').text(''); // clear error if valid

                    let productDisplay = customer.product;
                    switch (customer.product) {
                        case 'VL': productDisplay = "Vehicle Loan"; break;
                        case 'BL': productDisplay = "Business Loan"; break;
                        case 'TL': productDisplay = "Term Loan"; break;
                        case 'CD': productDisplay = "CD Loan"; break;
                        case 'GL': productDisplay = "Gold Loan"; break;
                    }
 $('#result').append(`
<div class="card credit-card-style mb-3">
    <div class="card-body">
        <div class="cc-number" style="color:black">${customer.loan_no.replace(/(.{4})/g, '$1 ')}</div>
        <div class="cc-row">
            <div>
                <div class="cc-label">Product</div>
                <div class="cc-value" style="color:black" id="product">${productDisplay}</div>
            </div>
            <div>
                <div class="cc-label">Due Amount</div>
                <div class="cc-value" style="color:black">₹${customer.due_amount}</div>
            </div>
        </div>
        <div class="cc-row">
            <div>
                <div class="cc-label">Other Charges</div>
                <div class="cc-value" style="color:black">₹${customer.other_charges}</div>
            </div>
            <div>
                <div class="cc-label">Date</div>
                <div class="cc-value" style="color:black">${new Date(customer.trans_date).toLocaleDateString()}</div>
            </div>
        </div>
        <div class="form-group" style="display:flex; gap:10px; margin-top:15px;">
            <input type="text" class="form-control" style="height:50px;" id="amount" placeholder="Enter Amount" value="${customer.due_amount}">
            <button class="btn btn-success pay-btn" data-loan="${customer.loan_no}" onclick="addpay('${customer.loan_no}', '${productDisplay}', ${customer.due_amount})" style="height:50px;">Add</button>
        </div>
    </div>
</div>
`);
                } else {
                    $('#field_error').text('Loan number not found.').css('color', 'red');
                }
            },
            error: function () {
                $('#load').hide();
                $('#fa').show();
                $('#field_error').text('Loan number not found.').css('color', 'red');
            }
        });
    });



