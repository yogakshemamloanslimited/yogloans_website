function paynow() {
    var encdata = $('#encdata').val();        
    var encdata1 = $('#encdata1').val();      
    var merchantId = $('#orderid').val();   
    alert(merchantId);  

    if (!encdata || !encdata1 || !merchantId) {
        alert("Missing required parameters!");
        return;
    }

    $.ajax({
        url: '/Home/PrepareSbiPayment', // your server endpoint
        method: 'POST',
        data: {
            EncryptTrans: encdata,
            MultiAccountInstructionDtls: encdata1,
            merchIdVal: merchantId
        },
        success: function(response) {
            // You can log or store the response here
            console.log('Server prepared SBI payment', response);

            // Redirect user to SBI
            window.location.href = 'https://www.sbiepay.sbi/secure/AggregatorHostedListener';
        },
        error: function(err) {
            console.error('Error preparing SBI payment', err);
        }
    });
}
function handleSbiFailure() {
    var encData = $('#encdata').val();
    alert('cominggggg')
    if (!encData) {
        alert("Missing encData!");
        return;
    }

    $.ajax({
        url: API.allapi.sbifailure,
        method: 'POST',
        data: { encData: encData },
        success: function(res) {
            if (res.success) {
                alert("Payment Status: " + res.status + "\nRef: " + res.sbiepayreferenceid);
            } else {
                alert("Error: " + res.message);
            }
        },
        error: function(err) {
            console.error(err);
            alert("Something went wrong while processing payment.");
        }
    });
}

