                    </div>
                </div>
                <div class="" style="margin-bottom:35px; width: 300px;
  margin: 20px auto;
    margin-bottom: 35px;
  font-family: 'Poppins', sans-serif;">
                    <h5>Filter By Company</h5>


                    <div class="values-com" style="display:flex; justify-content:center; align-items:start; gap:8px; flex-direction:column;">
                       
                    </div>
                </div>
                <div class="" style="margin-bottom:35px; width: 300px;
  margin: 20px auto;
    margin-bottom: 35px;
  font-family: 'Poppins', sans-serif;">
                    <h5>Filter By Model Year</h5>


                    <div class="filter-model" style="display:flex; justify-content:center; align-items:start; gap:8px; flex-direction:column;">
                       
                    </div>
                </div>
                
               @*  <div class="" style="margin-bottom:35px; width: 300px;
  margin: 20px auto;
    margin-bottom: 35px;
  font-family: 'Poppins', sans-serif;">
                    <h5>Filter By Location</h5>


                    <div class="range-values" style="display:flex; justify-content:center; align-items:start; gap:8px; flex-direction:column;">
                        <span style="display:flex; gap:3px;"><input type="checkbox" />ALL</span>
                        <span style="display:flex; gap:3px;"><input type="checkbox" />Model Details</span>
                    </div>
                </div> *@
            </div>
            </div>

            </div>
           
          
    <div class="cards" style="position: relative; width:75%;">
       
      
        <div class="top-bar" style="width:100%; padding:10px; max-height:200px;">
            <div class="top-filter" style="width:100%; display:flex; flex-direction:row; align-items:center; justify-content:space-between;">
                <input type="text" id="search-bike" class="form-control" style="width:30%" placeholder="Search your dream bike" />
                <div class="sort-by" style="width:40%; display:flex; gap:5px; justify-content:center; align-items:center;">
                    <label>Sort By :</label>
                    <select id="sort-bikes" class="form-control" style="width:70%;">
                        <option value="">-select-</option>
                        <option value="price-low">Price [Lowest to Highest]</option>
                        <option value="price-high">Price [Highest to Lowest]</option>
                        <option value="name">Name [A to Z]</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="preloader2" style="width:100%; height:100%; background:white;  position:absolute; 
  max-height: 550px;
  z-index: 4000000;
  display: flex;
  justify-content: center;
  align-items: center;">
            <img src="/images/icon/mountain-bike.png"
                 class="loading-icon"
                 style="width:50px; height:50px;  top:50%; left:50%; transform:translate(-50%, -50%);" />
        </div>
        <div class="card-items">
         
        </div>
       
     
    </div>

</section>
<div class="filter-popping">
    <div class="filter-image">
        <img src="~/images/icon/filter.png" id="filter-image" />
    </div>
  
</div>
<script>
   
    

    const slider = document.getElementById("priceRange");
    const output = document.getElementById("priceValue");

    slider.oninput = function() {
      output.textContent = `₹${parseInt(this.value).toLocaleString()}`;

      const percent = ((this.value - this.min) / (this.max - this.min)) * 100;
      this.style.background = `linear-gradient(90deg, #044697 ${percent}%, #ddd ${percent}%)`;
    };
</script>
<script>
     $(window).on('scroll', function() {
      if ($(this).scrollTop() > 250) {
        $('#inner-child').css('top', '5%');  // slide down (visible)
      } else {
        $('#inner-child').css('top', '41%');  // slide back up (hidden)
      }
    });
        const button = document.querySelector('#top-btn');

    const displayButton = () => {
      window.addEventListener('scroll', () => {
        console.log(window.scrollY);

        if (window.scrollY > 250) {
          button.style.display = "block";
        } else {
          button.style.display = "none";
        }
      });
    };

    const scrollToTop = () => {
      button.addEventListener("click", () => {
        window.scroll({
          top: 0,
          left: 0,
          behavior: 'smooth'
        });
        console.log(event);
      });
    };

    displayButton();
    scrollToTop();


</script>
<script>
       $(document).ready(function () {
                  $('.loader-mask').append(`
        <img src="/images/icon/mountain-bike.png"
             class="loading-icon"
             style="width:50px; height:50px; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%);" />
    `);

                   // Get session string from Razor
             var mobile = '@Context.Session.GetString("mobile")';
           
        $.ajax({
            url: API.allapi.Finduser,
            method: "GET",
            data: { mobile: mobile },
            success: function (re) {
                console.log(re); // check what the API returns
                
                if (re && re.length > 0) {
                      $('.fc-button-group').empty();
               
                    $('.fc-button-group').append(`
                        
                        <p style="padding:10px; text-transform:capitalize;">
                            ${re[0].bidder_name}
                        </p>
                    
                    `);
                } else {
                      $('.fc-button-group').empty();

                    $('.fc-button-group').append(`

                          <button class="btn btn-close-white btn-shadow">Singup</button><button class="btn btn-close-white btn-shadow">Login</button>
                   `);
                }
            },
            error: function (xhr, status, error) {
              $('.fc-button-group').empty();

                    $('.fc-button-group').append(`

                          <button class="btn btn-close-white btn-shadow">Singup</button><button class="btn btn-close-white btn-shadow">Login</button>
                   `);
            }
        });

        });
              $.ajax({
        url: API.allapi.Printitems,
        method: "GET",
        success: function (res) {
            if (res.success && Array.isArray(res.data)) {

                   // inside your $.ajax success where res.data exists
    let bikeList = res.data;

    // normalize field names if necessary (optional)
    // bikeList.forEach(b => { b.Year = b.Year?.toString(); b.make = b.make?.toString(); });

    let minPrice = Math.min(...bikeList.map(b => b.Amount));
    let maxPrice = Math.max(...bikeList.map(b => b.Amount));
        $('.range-values').empty();
                         $('.range-values').append(`<span>${minPrice}</span> <span>${maxPrice}</span>`);
    $('#priceRange').attr('min', minPrice).attr('max', maxPrice).val(maxPrice);
    $('#priceValue').text('₹' + maxPrice.toLocaleString());

    // render cards (purely visual)
    function renderCards(list) {
                      $('.preloader2').show();
                  //$('.loader-mask').delay(450).fadeOut('slow');
        $('.card-items').empty();
        if (!list.length) {
                   $('.preloader2').fadeOut();
                $('.card-items').append('<img src="/images/Tiredman.jpg"  style="width:200px; height:200px; position:absolute; left:50%; opacity:0.3; transform: translate(-50%,-10%);"/>');
            return;
        }
        list.forEach(item => {
            $('.card-items').append(`
                       <div class="card" style="margin:5px;" data-application="${item.application_id}">
                    <div class="top" style="position:relative; background-image:url('${item.image_url}');
                        height:210px; background-position:center; background-repeat:no-repeat; background-size:contain;">
                        <p style="position:absolute; left:0; top:0; background:black; color:white; padding:5px;
                            border-top-right-radius:20px; border-bottom-right-radius:20px;">
                            ₹${(item.Amount || 0).toLocaleString()}
                        </p>
                    </div>
                    <div class="bottom-details" style="height:100px; padding:10px 20px;">
                        <div style="font-weight:600">${item.product_name || ''}</div>
                        <div style="font-size:12px; color:#666;">${item.make || ''} - ${item.Year || ''} - ${item.location || ''}</div>
                    </div>
                </div>
            `);
        });
              $('.preloader2').fadeOut();
    }

    // generate unique checkbox lists ONCE
    let uniqueMakes = [...new Set(bikeList.map(b => b.make).filter(Boolean))].sort();
    let uniqueModels = [...new Set(bikeList.map(b => b.Year).filter(v => v !== undefined && v !== null))].map(String);
    uniqueModels = [...new Set(uniqueModels)].sort((a,b) => a.localeCompare(b)); // ensure unique & string

    $('.values-com').empty();
    $('.filter-model').empty();

    uniqueMakes.forEach(make => {
        // name/class used for selecting checked values
        $('.values-com').append(`<span style="display:flex; gap:6px; align-items:center;">
            <input type="checkbox" class="make-filter" value="${make}" /> <span>${make}</span>
        </span>`);
    });

    uniqueModels.forEach(year => {
        // convert to string for the checkbox value
        $('.filter-model').append(`<span style="display:flex; gap:6px; align-items:center;">
            <input type="checkbox" class="model-filter" value="${year}" /> <span>${year}</span>
        </span>`);
    });

    // Combined filter function (search + price + makes + models + sort)
    function applyFilters() {
        let searchTerm = $('#search-bike').val()?.toLowerCase() || '';
        let selectedPrice = parseFloat($('#priceRange').val()) || maxPrice;
        let sortValue = $('#sort-bikes').val();

        let selectedMakes = $('.make-filter:checked').map(function(){ return $(this).val(); }).get();
        let selectedModels = $('.model-filter:checked').map(function(){ return $(this).val(); }).get();

        // DEBUG (uncomment if you need)
        // console.log({searchTerm, selectedPrice, selectedMakes, selectedModels, sortValue});

        let filtered = bikeList.filter(bike => {
            // normalize for comparison (convert everything to string)
            let pname = (bike.product_name || '').toLowerCase();
            let make = bike.make == null ? '' : String(bike.make);
            let year = bike.Year == null ? '' : String(bike.Year);

            let matchSearch = pname.includes(searchTerm);
            let matchPrice = (typeof bike.Amount === 'number') ? (bike.Amount <= selectedPrice) : true;
            let matchMake = selectedMakes.length === 0 || selectedMakes.includes(make);
            let matchModel = selectedModels.length === 0 || selectedModels.includes(year);

            return matchSearch && matchPrice && matchMake && matchModel;
        });

        // sorting
        if (sortValue === 'price-low') filtered.sort((a,b) => (a.Amount||0) - (b.Amount||0));
        else if (sortValue === 'price-high') filtered.sort((a,b) => (b.Amount||0) - (a.Amount||0));
        else if (sortValue === 'name') filtered.sort((a,b) => (a.product_name||'').localeCompare(b.product_name||''));

        renderCards(filtered);
    }

    // initial render
    renderCards(bikeList);

    // wire events to the single applyFilters function
    $(document).on('input', '#search-bike', applyFilters);
    $(document).on('input', '#priceRange', function(){
        $('#priceValue').text('₹' + parseInt($(this).val()).toLocaleString());
        applyFilters();
    });
    $(document).on('change', '#sort-bikes', applyFilters);
    $(document).on('change', '.make-filter, .model-filter', applyFilters);

            } else {
                console.error("Unexpected response format:", res);
            }
        },
        error: function (xhr, status, error) {
            console.error("AJAX Error:", error);
        }
    });
           $('.filter-popping').on('click', function () {
            const filterBox = $('.filter');
        const filterIcon = $('#filter-image');

        if (filterBox.is(':visible')) {
            // 🔹 Hide filter
            filterBox.css({
                visibility: 'hidden',
                opacity: '0',
                transform: 'translateY(20px)',
                display: 'none',
                position:'absolute'
            });
            // Change icon to "filter"
            filterIcon.attr('src', '/images/icon/filter.png');
        } else {
            // 🔹 Show filter
            filterBox.css({
                visibility: 'visible',
                opacity: '1',
                transform: 'translateY(0)',
                display: 'block',
                           position:'absolute'
            });
            // Change icon to "close"
            filterIcon.attr('src', '/images/icon/arrow(1).png');
        }
});

    $(document).on('click', '.card', function() {
        const appId = $(this).data('application');
     
  
           $.ajax({
        url: '@Url.Action("Application_Id", "Vehicleseizing")',
        type: 'POST', // or 'POST'
            data: { Application_Id: appId },
        success: function (response) {
                    window.location.href = '@Url.Action("Productdetails", "Vehicleseizing")';
        },
        error: function (xhr, status, error) {
            console.error(error);
        }
    });

        });
</script>