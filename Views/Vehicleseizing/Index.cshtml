@{
    Layout = "~/Views/Shared/_Auction_layout.cshtml";
    ViewData["Title"] = "Seizing";
}
<style>
    .welcome-container{
        display:flex;
        justify-content:space-between;
        align-items:center;
        padding:30px;
        height: 250px;
        width:80%;
    }

    .cards {

        width: 100%;
        padding:20px;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px; /* optional spacing between cards */
    }

    #top-btn {
        display: none;
        cursor: pointer;
        position: fixed;
        bottom: 20px;
        right: 30px;
        z-index: 99;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background-color: rgb(12, 12, 12);
        color: white;
        border: none;
    }
        .cards .card {
        width:100%;
            margin-top: 50px;
        height:300px;
        background:white;
        cursor:pointer;
    }
    .cards .card img{
        height:200px;
        width:100%;
    }

    .fc-button-group {
        display: block;
    }

    .filter-section {
     
       display:flex; 
       justify-content:space-between;
       flex-direction:column;
      
       
        height: 700px;
    }

        .filter-section #inner-child {
            background: white;
        height: 700px;
        position: fixed;
        width: 25%;
        top:50%;
        transition:0.5s;
    }
    @@media(max-width:780px){
        .welcome-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 5px;
            height: 250px;
            width: 100%;
        }

        .welcome-container .form-group{
            width:100%;
        }

        #welcome-image {
            position: absolute;
            top: 50%;
            left: 50%;
            transition:;
            transform: translate(-50%,-50%);
            height: 100%;
            width: 100%;
            z-index: -1;
            display: flex;
            justify-content: center;
        }

            #welcome-image img {
            position: absolute;
            width: 200px;
            opacity: 0.5;
            top: 15%;
        }

        .fc-button-group{
            display:none;
        }

        .fc-button-group2 {
            display: block;
        }
    }

    .price-range {
        width: 300px;
        margin: 80px auto;
        font-family: 'Poppins', sans-serif;
    }

    .price-label {
        display: block;
        font-weight: 600;
        margin-bottom: 10px;
        color: #333;
    }

    .price-slider {
        -webkit-appearance: none;
        width: 100%;
        height: 8px;
        border-radius: 5px;
        background: linear-gradient(90deg, #ffb300 50%, #ddd 50%);
        outline: none;
        transition: background 0.3s;
    }

        .price-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #ffb300;
            cursor: pointer;
            box-shadow: 0 0 6px rgba(0,0,0,0.3);
            transition: background 0.3s ease;
        }

            .price-slider::-webkit-slider-thumb:hover {
                background: #ff9800;
            }

    .range-values {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        margin-top: 5px;
        color: #666;
    }

        </style>
<button class="btn" id="top-btn" style="font-size: 25px;"><i class="fa-solid fa-arrow-up"></i></button>
<div style="width:100%; display:flex; justify-content:center;">


    <section class="welcome-container">
        <div class="form-group" style="z-index: 40;">

            <p>Bikes</p>
