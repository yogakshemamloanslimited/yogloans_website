@{
    Layout = "~/Views/Shared/_Auction_layout.cshtml";
    ViewData["Title"] = "Seizing";
}
<style>
    .welcome-container{
        display:flex;
        justify-content:space-between;
        align-items:center;
        padding:30px;
        height: 250px;
        width:80%;
    }

    .cards {

        width: 100%;
        padding:20px;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px; /* optional spacing between cards */
    }

        .cards .card {
        width:100%;
            margin-top: 50px;
        height:300px;
        background:white;
        cursor:pointer;
    }
    .cards .card img{
        height:200px;
        width:100%;
    }

    .fc-button-group {
        display: block;
    }
    @@media(max-width:780px){
        .welcome-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 5px;
            height: 250px;
            width: 100%;
        }

        .welcome-container .form-group{
            width:100%;
        }

        #welcome-image {
            position: absolute;
            top: 50%;
            left: 50%;
            transition:;
            transform: translate(-50%,-50%);
            height: 100%;
            width: 100%;
            z-index: -1;
            display: flex;
            justify-content: center;
        }

            #welcome-image img {
            position: absolute;
            width: 200px;
            opacity: 0.5;
            top: 15%;
        }

        .fc-button-group{
            display:none;
        }

        .fc-button-group2 {
            display: block;
        }
    }
        </style>
<div style="width:100%; display:flex; justify-content:center;">


