        <div class="form-group" style="z-index: 40; color:white; width:80%;">

            <p>Bikes</p>
            <h1>Not just bikes. A collection of pure passion on wheels.</h1>
            <p>
                Discover bikes crafted for elegance, performance, and power.
            </p>
        </div>
      @*   <div class="form-group" id="welcome-image">

            <img src="~/images/bike-back.png" />
        </div> *@
    </section>
</div>
