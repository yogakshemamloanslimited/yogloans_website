@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register For Fly</title>
    <link rel="icon" type="image/png" href="~/images/logo/logo.png" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="~/js/api.js"></script>
    <script src="~/js/jaquery.js" asp-append-version="true"></script>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            list-style: none;
            text-decoration: none;
            font-family: 'Poppins', sans-serif;
            transition: 0.3s;
        }

        body {
            background-color: #f8f9fa;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .card-container {
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            width: 100%;
            max-width: 450px;
        }

        .image-wrapper {
            position: relative;
            width: 100%;
            text-align: center;
        }

        #msgBox.success {
            color: green;
            font-weight: 500;
        }

        #msgBox.error {
            color: red;
            font-weight: 500;
        }

        #msgBox2.success {
            color: green;
            font-weight: 500;
        }

        #msgBox2.error {
            color: red;
            font-weight: 500;
        }


        .image-wrapper p {
            position: absolute;
            color: white;
            font-size: 1.1rem;
            font-weight: 600;
            left: 5%;
            bottom: 45%;
            z-index: 10;
            text-shadow: 1px 1px 4px rgba(0,0,0,0.6);
        }

        .image-wrapper img {
            width: 100%;
            height: auto;
            display: block;
        }

        form {
            padding: 20px;
        }

        .input-group img {
            width: 20px;
            height: 20px;
        }

        /* ✅ Responsive tweaks */
        @@media (max-width: 576px) {
            .image-wrapper p {
                font-size: 12px;
                bottom: 40%;
            }

            #msgBox {
                font-size: 10px !important;
            }

            #msgBox2 {
                font-size: 10px !important;
            }

            input, a, textarea, button {
                font-size: 12px !important;
            }

            form {
                padding: 15px;
            }
        }
        </style>
</head>
<body>
    <div class="card-container">
        <div class="image-wrapper">
            <p>Login</p>
            <img src="~/images/seizingauth.png" alt="Seizing Auth Image" />
        </div>
        <form>
            <div class="form-group">
                <div class="input-group mb-3">
                    <span class="input-group-text bg-white">
                        <img src="/images/icon/dialpad.png" alt="Dialpad Icon">

                    </span>
                    <input id="mobile" type="text" class="form-control" name="mobile" placeholder="Enter Mobile Number">
                    <button class="btn btn-success btn-sm" type="button" id="sendBtn"><img src="~/images/icon/send.png" style="width:20px;height:20px; filter: invert(1);" /></button>
                </div>
                <p id="msgBox" style="font-size:13px; text-align:left;  display:none;"></p>
                <div class="input-group " id="otp-section" style="display:none; margin-top:20px;">
                    <span class="input-group-text bg-white">
                        <img src="/images/icon/password.png" alt="Dialpad Icon">

                    </span>
                    <input id="otpentered" type="text" class="form-control" name="otpentered" placeholder="Enter Otp">
                    <button class="btn btn-success btn-sm" id="verifyBtn" type="button"><img src="~/images/icon/approve.png" style="width:20px;height:20px; filter: invert();" /></button>
                </div>
                <p id="msgBox2" style="font-size:13px; text-align:left;  display:none;"></p>

                <div class="form-group" style="display:flex; justify-content:center; align-items:center; gap:5px; flex-direction:column;">
                    <a class="text-primary" style="cursor: pointer;
  font-size: 15px;  text-decoration: none !important;" href="/vehicleseizing/Register">Dont have a account ?  Register</a>
                    <a class="text-primary" style="cursor: pointer;
  font-size: 15px;  text-decoration: none !important;" href="/vehicleseizing"> Skip For Now</a>
                </div>

            </div>
            <input type="hidden" id="recieved-otp" />
        </form>
    </div>

    <!-- Bootstrap JS (optional, for components like modals or tooltips) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
                
        $('#sendBtn').on('click', function () {
              var mobile = $('#mobile').val().trim();
           

            if (mobile === "" || mobile.length < 10) {
                $('#msgBox').text('Please enter a valid mobile number.')
                    .removeClass('success').addClass('error').fadeIn();
                return;
            }

            $.ajax({
                url: API.allapi.SeizingLogin,
                method: "GET",
                data: { mobile: mobile },
                success: function (a) {
                 $('#recieved-otp').val(a.otp);
                    alert(a.otp);
                    if (a.status == "1") {
                        $('#otp-section').show();

                        // change button look and text after first success
                        $('#sendBtn').html(`<img src="/images/icon/send-data.png" style="width:20px;height:20px; filter:invert(1);" />`);
                        $('#sendBtn').css('background', 'blue');

                        // ✅ Dynamic message based on first or resend click
                        if (!isResent) {
                            $('#msgBox')
                                .text('OTP sent successfully! Please check your phone.')
                                .removeClass('error').addClass('success').fadeIn();
                            isResent = true; // now future clicks are resend
                        } else {
                            $('#msgBox')
                                .text('OTP resent successfully! Please check again.')
                                .removeClass('error').addClass('success').fadeIn();
                        }
                    } else {
                        $('#msgBox')
                            .text(a.message || 'Failed to send OTP. Please try again.')
                            .removeClass('success').addClass('error').fadeIn();
                    }
                },
                error: function () {
                    $('#msgBox')
                        .text('Something went wrong. Please try again later.')
                        .removeClass('success').addClass('error').fadeIn();
                }
            });
        });
         var pagestate = '@Context.Session.GetString("pagestate")';
        $('#verifyBtn').on('click',function(){
             var mobile = $('#mobile').val().trim();
          var sessionOtp =$('#recieved-otp').val();

          var enteredotp = $('#otpentered').val();

            if (enteredotp != sessionOtp) {
                             // now future clicks are resend


                                   $('#msgBox2')
               .text('Entered Otp Is Inccorect.')
               .removeClass('success').addClass('error').fadeIn();
               $('#msgBox').hide();
               
                            isResent = true;
              } else {

                
                     $.get(`/post-mobile?mobile=${mobile}`)
                            .done(function () {
                                if(pagestate==1){
                                   window.location.href = '/vehicleseizing/productdetails';
                                }
                                else{
                                       window.location.href = '/vehicleseizing';
                                }
                             
                            })
                            .fail(function (xhr) {
                                alert("Error saving mobile: " + xhr.status);
                            });
                     
                  
                        }

        });
    </script>
</body>
</html>
