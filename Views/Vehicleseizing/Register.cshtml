@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register For Fly</title>
    <link rel="icon" type="image/png" href="~/images/logo/logo.png" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            list-style: none;
            text-decoration: none;
            font-family: 'Poppins', sans-serif;
            transition: 0.3s;
        }

        body {
            background-color: #f8f9fa;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .card-container {
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            width: 100%;
            max-width: 400px;
        }

        .image-wrapper {
            position: relative;
            width: 100%;
            text-align: center;
        }

            .image-wrapper p {
                position: absolute;
                color: white;
                font-size: 1.1rem;
                font-weight: 600;
                left: 5%;
                bottom: 45%;
                z-index: 10;
                text-shadow: 1px 1px 4px rgba(0,0,0,0.6);
            }

            .image-wrapper img {
                width: 100%;
                height: auto;
                display: block;
            }

        form {
            padding: 20px;
        }

        .input-group img {
            width: 20px;
            height: 20px;
        }

        /* ✅ Responsive tweaks */
        @@media (max-width: 576px) {
            .image-wrapper p

        {
            font-size: 1rem;
            bottom: 40%;
        }

        form {
            padding: 15px;
        }

        }
    </style>
</head>
<body>
    <div class="card-container">
        <div class="image-wrapper">
            <p>Register To Fly</p>
            <img src="~/images/seizingauth.png" alt="Seizing Auth Image" />
        </div>
        <form>
            <div class="form-group">
            <div class="input-group mb-3">
                <span class="input-group-text bg-white">
                    <img src="/images/icon/dialpad.png" alt="Dialpad Icon">
                    
                </span>
                <input id="mobile" type="text" class="form-control" name="mobile" placeholder="Enter Mobile Number">
                <button class="btn btn-success btn-sm"><img src="~/images/icon/send.png" style="width:20px;height:20px; filter: invert(1);" /></button>
            </div>
            <div class="form-group" style="display:flex; justify-content:center; align-items:center; gap:5px; flex-direction:column;">
                    <a class="text-primary" style="cursor: pointer;
  font-size: 15px;" href="/vehicleseizing/Login">Already have a account ?  Login</a>
                    <a class="text-primary" style="cursor: pointer;
  font-size: 15px;" href="/vehicleseizing"> Skip</a>
            </div>
           
            </div>
        </form>
    </div>

    <!-- Bootstrap JS (optional, for components like modals or tooltips) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
