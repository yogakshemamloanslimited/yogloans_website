@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register For Fly</title>
    <link rel="icon" type="image/png" href="~/images/logo/logo.png" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="~/js/api.js"></script>
    <script src="~/js/jaquery.js" asp-append-version="true"></script>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            list-style: none;
            text-decoration: none;
            font-family: 'Poppins', sans-serif;
            transition: 0.3s;
        }

        body {
            background-color: #f8f9fa;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .card-container {
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            width: 100%;
            max-width: 450px;
        }

        .image-wrapper {
            position: relative;
            width: 100%;
            text-align: center;
        }

        #msgBox.success {
            color: green;
            font-weight: 500;
        }

        #msgBox.error {
            color: red;
            font-weight: 500;
        }

        #msgBox2.success {
            color: green;
            font-weight: 500;
        }

        #msgBox2.error {
            color: red;
            font-weight: 500;
        }


            .image-wrapper p {
                position: absolute;
                color: white;
                font-size: 1.1rem;
                font-weight: 600;
                left: 5%;
                bottom: 45%;
                z-index: 10;
                text-shadow: 1px 1px 4px rgba(0,0,0,0.6);
            }

            .image-wrapper img {
                width: 100%;
                height: auto;
                display: block;
            }

        form {
            padding: 20px;
        }

        .input-group img {
            width: 20px;
            height: 20px;
        }

        /* ✅ Responsive tweaks */
        @@media (max-width: 576px) {
            .image-wrapper p

        {
            font-size: 12px;
            bottom: 40%;
        }

            #msgBox{
                font-size:10px !important;
            }

            #msgBox2 {
                font-size: 10px !important;
            }
        input , a , textarea , button {
            font-size:12px !important;
        }
        form {
            padding: 15px;
        }

        }
    </style>
</head>
<body>
    <input type="hidden" id="recieved-otp" />
    <div class="card-container">
        <div class="image-wrapper">
            <p>Register To Fly</p>
            <img src="~/images/seizingauth.png" alt="Seizing Auth Image" />
        </div>
        <form>
            <div class="form-group">
            <div class="input-group " id="entering-section">
                <span class="input-group-text bg-white">
                    <img src="/images/icon/dialpad.png" alt="Dialpad Icon">
                    
                </span>
                <input id="mobile" type="text" class="form-control" name="mobile" placeholder="Enter Mobile Number">
                <button class="btn btn-success btn-sm" id="sendBtn" type="button"><img src="~/images/icon/send.png" style="width:20px;height:20px; filter: invert(1);" /></button>
            </div>
                <p id="msgBox" style="font-size:13px; text-align:left;  display:none;"></p>
                <div class="input-group " id="otp-section" style="display:none; margin-top:20px;">
                    <span class="input-group-text bg-white">
                        <img src="/images/icon/password.png" alt="Dialpad Icon">

                    </span>
                    <input id="otpentered" type="text" class="form-control" name="otpentered" placeholder="Enter Otp">
                    <button class="btn btn-success btn-sm" id="verifyBtn" type="button"><img src="~/images/icon/approve.png" style="width:20px;height:20px; filter: invert();" /></button>
                </div>
                <p id="msgBox2" style="font-size:13px; text-align:left;  display:none;"></p>

                <div class="input-group" id="name-section" style="display:none; margin-top:20px;">
                    <span class="input-group-text bg-white">
                        <img src="/images/icon/id-card.png" alt="Dialpad Icon">
                    </span>
                    <input id="name" type="text" class="form-control" name="name" placeholder="Enter Full Name">
                </div>
                <span id="name-error" class="error-text text-danger"></span>

                <div class="input-group" id="pan-section" style="display:none; margin-top:20px;">
                    <span class="input-group-text bg-white">
                        <img src="/images/icon/user(2).png" alt="Dialpad Icon">
                    </span>
                    <input id="pan" type="text" class="form-control" name="pan" placeholder="Enter Pan Number" value="ABCDE1234F">
                </div>
                <span id="pan-error" class="error-text text-danger"></span>

                <div class="input-group" id="adhar-section" style="display:none; margin-top:20px;">
                    <span class="input-group-text bg-white">
                        <img src="/images/icon/driving.png" alt="Dialpad Icon">
                    </span>
                    <input id="adhar" type="text" class="form-control" value="123456789012" name="adhar" placeholder="Enter Aadhar Number">
                </div>
                <span id="adhar-error" class="error-text text-danger"></span>

                <div class="input-group" id="gst-section" style="display:none; margin-top:20px;">
                    <span class="input-group-text bg-white">
                        <img src="/images/icon/board.png" alt="Dialpad Icon">
                    </span>
                    <input id="gst" type="text" class="form-control" value="22ABCDE1234F1Z5" name="gst" placeholder="Enter GST Number">
                </div>
                <span id="gst-error" class="error-text text-danger"></span>

                <div class="input-group" id="address-section" style="display:none; margin-top:20px;">
                    <span class="input-group-text bg-white">
                        <img src="/images/icon/pin.png" alt="Dialpad Icon">
                    </span>
                    <textarea id="address" class="form-control" placeholder="Enter Address Details"></textarea>
                </div>
                <span id="address-error" class="error-text text-danger"></span>

                <button type="button" class="btn btn-success" id="submit-details"
                        style="display:none; margin-top:20px; left:30%; position:relative;">
                    Submit Details
                </button>

            <div class="form-group" style="display:flex; margin-top:20px; justify-content:center; align-items:center; gap:5px; flex-direction:column;">
                    <a class="text-primary" style="cursor: pointer;
  font-size: 15px;  text-decoration: none !important;" href="/vehicleseizing/Login">Already have a account ?  Login</a>
                    <a class="text-primary" style="cursor: pointer;
  font-size: 15px;  text-decoration: none !important;" href="/vehicleseizing"> Skip For Now</a>
            </div>
           
            </div>
        </form>
    </div>

    <!-- Bootstrap JS (optional, for components like modals or tooltips) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
                   let isResent = false; // flag to know if resend is happening

        $('#sendBtn').on('click', function () {
            
            var mobile = $('#mobile').val().trim();

            if (mobile === "" || mobile.length < 10) {
                $('#msgBox').text('Please enter a valid mobile number.')
                    .removeClass('success').addClass('error').fadeIn();
                return;
            }

            $.ajax({
                url: API.allapi.SeizingRegister,
                method: "GET",
                data: { mobile: mobile },
                success: function (a) {
                 $('#recieved-otp').val(a.otp);
                    alert(a.otp);
                    if (a.status == "1") {
                        $('#otp-section').show();

                        // change button look and text after first success
                        $('#sendBtn').html(`<img src="/images/icon/send-data.png" style="width:20px;height:20px; filter:invert(1);" />`);
                        $('#sendBtn').css('background', 'blue');

                        // ✅ Dynamic message based on first or resend click
                        if (!isResent) {
                            $('#msgBox')
                                .text('OTP sent successfully! Please check your phone.')
                                .removeClass('error').addClass('success').fadeIn();
                            isResent = true; // now future clicks are resend
                        } else {
                            $('#msgBox')
                                .text('OTP resent successfully! Please check again.')
                                .removeClass('error').addClass('success').fadeIn();
                        }
                    } else {
                        $('#msgBox')
                            .text(a.message || 'Failed to send OTP. Please try again.')
                            .removeClass('success').addClass('error').fadeIn();
                    }
                },
                error: function () {
                    $('#msgBox')
                        .text('Something went wrong. Please try again later.')
                        .removeClass('success').addClass('error').fadeIn();
                }
            });
        });

        $('#verifyBtn').on('click',function(){
          var sessionOtp =$('#recieved-otp').val();
        
          var enteredotp = $('#otpentered').val();
         
            if (enteredotp != sessionOtp) {
                             // now future clicks are resend
                            

                                   $('#msgBox2')
               .text('Entered Otp Is Inccorect.')
               .removeClass('success').addClass('error').fadeIn();
               $('#msgBox').hide();
                $('#name-section').hide();
                  $('#pan-section').hide();
                   $('#gst-section').hide();
                      $('#adhar-section').hide();
                         $('#address-section').hide();
                         $('#submit-details').hide();
                            isResent = true;
              } else {
                           
                  $('#msgBox2') .text('Otp Verified Successfully.')
                   .removeClass('error').addClass('success').fadeIn();
                   $('#otpentered').attr('readonly');
                   $('#msgBox').hide();
                   $('#name-section').show();
                   $('#pan-section').show();
                   $('#gst-section').show();
                      $('#adhar-section').show();
                      $('#submit-details').show();
                         $('#address-section').show();
                        }
        
        });

                  $('#submit-details').on('click', function () {
            // Clear previous errors
            $('.error-text').text('');

            const mobile = $('#mobile').val()?.trim();
            const name = $('#name').val()?.trim();
            const address = $('#address').val()?.trim();
            const pan = $('#pan').val()?.trim();
            const gst = $('#gst').val()?.trim();
            const adhar = $('#adhar').val()?.trim();

            let isValid = true;

            // ======= Front-end Validations =======
            if (!mobile) {
                $('#mobile-error').text('Mobile number is required.');
                isValid = false;
            }
            // } else if (!/^[6-9]\d{9}$/.test(mobile)) {
            //     $('#mobile-error').text('Enter a valid 10-digit mobile number.');
            //     isValid = false;
            // }

            if (!name) { $('#name-error').text('Name is required.'); isValid = false; }
            if (!address) { $('#address-error').text('Address is required.'); isValid = false; }
            if (!adhar) { $('#adhar-error').text('Aadhar number is required.'); isValid = false; }
            // else if (!/^\d{12}$/.test(adhar)) {
            //     $('#adhar-error').text('Enter a valid 12-digit Aadhar number.');
            //     isValid = false;
            // }
            if (!gst) { $('#gst-error').text('GST number is required.'); isValid = false; }
            // else if (!/^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/.test(gst)) {
            //     $('#gst-error').text('Enter a valid GST number.');
            //     isValid = false;
            // }
            if (!pan) { $('#pan-error').text('PAN number is required.'); isValid = false; }
            // else if (!/^[A-Z]{5}[0-9]{4}[A-Z]{1}$/.test(pan)) {
            //     $('#pan-error').text('Enter a valid PAN number.');
            //     isValid = false;
            // }

            if (!isValid) return;

            // Disable button to prevent resubmission
            $('#submit-details').prop('disabled', true).text('Submitting...');

            // ======= 1st API Call =======
            $.ajax({
                url: API.allapi.Submituserform,
                method: "GET",
                data:{mobile:mobile, name:name , address:address, pan:pan , gst:gst , adhar:adhar},
                success: function (response) {
                    if (response.message) {
                        // ======= 2nd API Call: Save mobile in session =======
                        $.get(`/post-mobile?mobile=${mobile}`)
                            .done(function () {
                                window.location.href = '/vehicleseizing';
                            })
                            .fail(function (xhr) {
                                alert("Error saving mobile: " + xhr.status);
                            });
                    } else {
                        alert("Something went wrong while submitting details.");
                    }
                },
                error: function (xhr) {
                    alert("Server error. Please try again later. (" + xhr.status + ")");
                },
                complete: function () {
                    $('#submit-details').prop('disabled', false).text('Submit Details');
                }
            });
        });


    </script>
</body>

</html>
