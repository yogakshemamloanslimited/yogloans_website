@{
    Layout = null;
}
@model yogloansdotnet.Models.LoanGroupViewModel


<style>
    .welcome-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: start;
        align-items: end;


        position: relative;
        background-color: white;

    }

    .items {
        width: 85%;
        height: 400px;
        transition: 0.5s ease-in-out;
        position: relative;
        @*   border-radius: 20%; *@
    }
#image-pro {
    transition: all 0.3s ease-in-out; /* smooth transition for size & position */
    position: relative; /* initial position */
    height: 250px;
    width: 100px;
}

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        width: 85%;
        margin-top: 10px;
    }

    .cards .card {
        background: #ffffff;
        height: 200px;
        /* fixed height for all cards */
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 10px;
        box-sizing: border-box;
        border-radius: 10px;
        text-align: center;
        position: relative;
    }

    .msg {

        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: start;

        text-transform: uppercase;
        position: fixed;
        left: -8%;
        bottom: 10%;
        height: 500px;

    }

    .msg h1 {
        transform: rotate(-90deg);
        /* ✅ Corrected */
        position: relative;
        left: 0%;

    }

    .msg h1 p {
        transform: rotate(360deg);
        /* ✅ Corrected */

        font-size: 15px;


    }

    #image1 {
        display: block;
    }

    #image2 {
        display: none;
    }

    .lable-bill {
        width: auto;
        border-top-right-radius: 50%;
        border-bottom-right-radius: 50%;
        background-color: #044697;
        height: 60px;
        width: auto;
        left: 0%;
        top: 0%;
        position: absolute;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 10px;
        gap: 5px;
        font-size: 15px;
    }

    #form-auction {
        height: 0px;
        overflow: hidden;
        transition: 0.5s ease-in-out;
    }

 

    tr{
        text-align: start !important;
    }



    @@media(max-width:900px) {
        .msg {
            display: none;
        }

        .items {
            width: 100%;
        }

        #image1 {
            display: none;
        }

        #image2 {
            display: block;
        }

        .cards{
            width:100%;
        }
    }
</style>

