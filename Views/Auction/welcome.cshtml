    function view(benchmark, net_wt, loan_no, netwt_purity, branch_name) {


        $.ajax({
            url: "http://localhost:8085/api/auction/print_popup/" + loan_no,
            method: "GET",
            success: function (response) {
                $("#product_deatiled").modal('show');
                console.log(response);
                let imgHtml = ""
                let firstde = ""
                let secondde = ""
              
                firstde += `
                <tr style="text-align:center !important;">
            
            
           
            <td style="width:25%; text-align:center">
                 ${net_wt}
            </td>
       
    
           
            <td style="width:25%; text-align:center">
                ${netwt_purity}
            </td>
    
        
           
            <td style="width:25%; text-align:center">
             ${branch_name}
            </td>
           </tr>
            `;
                if (response.Images && response.Images.length > 0) {

                    response.Images.forEach(function (img) {
                        // prepend the base64 header
                        imgHtml += `<img src="data:image/jpeg;base64,${img.image_orna}" 
                        style="width:250px;height:100px;margin:5px;" id="image-pro">`;
                    });
                } else {
                    imgHtml = "<p>No images found</p>";
                }
                if (response.LoanDetails && response.LoanDetails.Table.length > 0) {
                    response.LoanDetails.Table.forEach(function (details) {
                        secondde += `
       
        <tr>
           <td >${details.Ornament}</td>
           <td >${details.Count}</td>
            <td >${details.Purity}</td>
        </tr>
       
        `;
                    });
                }


                $("#product_image").html(imgHtml);
                $("#first-details").html(firstde);
                $("#second-details").html(secondde);


            },
            error: function (xhr, status, error) {
                console.error("Error fetching images:", error);
            }
        });
    }
