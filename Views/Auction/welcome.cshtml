<script>
           var sessionMobile = '@Context.Session.GetInt32("mobile")';
        var sessionOtp = '@Context.Session.GetInt32("otp")';
           function viewproduct() {
        var auctionId = $('#auctionId').val();
        var stateId = $('#stateId').val();
    $.ajax({
        url: `http://localhost:8085/api/auction/print2/${auctionId}/${stateId}`,
        method: "GET",
        success: function (packResponse) {

            // ✅ Log / Alert full response
            console.log("Full API Response:", packResponse);

            let table0 = packResponse.Table;
                 let table2 = packResponse.Table2;   // get 3rd row (0-based index)

        // ✅ Alert readable data
            alert(JSON.stringify(table2, null, 2));

            if (!table0 || table0.length === 0) {
                $('#product .modal-body').html("<p>No packs found.</p>");
                $('#product').modal('show');
                return;
            }

            // ✅ Calculate totals
            let totalCount = table0.length;
            let totalNetWt = table0.reduce((sum, row) => sum + (parseFloat(row.net_wt) || 0), 0);
            let totalNetWtPurity = table0.reduce((sum, row) => sum + (parseFloat(row.netwt_purity) || 0), 0);
                let benchvalue = table2[0].benchmark_gram;

                

            // ✅ Alert totals
            alert(
                "Total Rows: " + totalCount +
                "\nTotal Net Wt: " + totalNetWt.toFixed(2) +
                "\nTotal NetWt Purity: " + totalNetWtPurity.toFixed(2)+
                        "benchvalue" + benchvalue
            );

            // Get table headers dynamically
            let headers = Object.keys(table0[0]);

            // Build table HTML
            let tableHtml = `
                <div style="overflow-x:auto;">
                    <table class="table table-bordered text-center">
                        <thead>
                            <tr>${headers.map(h => `<th>${h}</th>`).join('')}</tr>
                        </thead>
                        <tbody>
                            ${table0.map(row => `
                                <tr>${headers.map(h => `<td>${row[h] ?? ''}</td>`).join('')}</tr>
                            `).join('')}
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="2">Totals</th>
                                <th>${totalNetWt.toFixed(2)}</th>
                                <th>${totalNetWtPurity.toFixed(2)}</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <p class="text-end"><strong>Total Rows: ${totalCount}</strong></p>
            `;

            // Insert into modal body
            $('#product .modal-body').html(tableHtml);

            // Show modal
            $('#product').modal('show');
        },
        error: function (xhr, status, error) {
            alert("Error fetching data:\n" + error);
            $('#product .modal-body').html("<p>Failed to fetch data.</p>");
            $('#product').modal('show');
        }
    });

    }

             $(document).ready(function () {
        var sessionMobile = '@(Context.Session.GetInt32("mobile")?.ToString() ?? "")';
        var sessionOtp = '@(Context.Session.GetInt32("otp")?.ToString() ?? "")';

        $('#view_product').hide();
        $('#nodata').hide();

        $.ajax({
            url: `http://localhost:8085/api/auction/print1/${sessionMobile}/${sessionOtp}`,
            method: "GET",
            success: function (response) {

                if (!response.Main) {
                    $('.cards').html("<p>No active bids found.</p>");
                    $('.welcome-container').hide();
                    $('#nodata').show();
                    return;
                }

                let main = response.Main;
                var auctionId = main.auction_id;
                var stateId = main.state_id;

                // === Header info ===
                $('#top-details').html(`
                    <p><strong>Auction ID :</strong> ${main.auction_id}</p>
                    <p><strong>Date :</strong> ${main.auc_date}</p>
                    <p><strong>Bidder Name :</strong> ${main.bidder_name}</p>
                    <p><strong>State :</strong> ${main.state}</p>
                `);

                // === CASE 1: Active Bidding Found1 (print1 has packs) ===
                if (response.Message === "Active Bidding Found1") {
                    let packs = response.Packs;
                    if (!packs || packs.length === 0) {
                        $('.welcome-container').hide();
                        $('.cards').html("<p>No active bids found.</p>");
                        $('#nodata').show();
                        return;
                    }

                    let headers = Object.keys(packs[0]);
                    let tableHtml = `
                        <div class="form-group" style="width:100%; display:flex; flex-direction:column; margin-top:20px; overflow-x:auto;">
                            <h4 style="width:100%; text-align:center;">Bidding Details</h4>
                            <table class="table table-bordered text-center">
                                <thead style="background:#f2f2f2;">
                                    <tr>${headers.map(h => `<th>${h}</th>`).join('')}</tr>
                                </thead>
                                <tbody>
                                    ${packs.map(row => `
                                        <tr>${headers.map(h => `<td>${row[h] ?? ''}</td>`).join('')}</tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;

                    $('.cards').html(tableHtml);
                }
                            

                // === CASE 2: Active Bidding Found (print1 empty, check print2) ===
                else if (response.Message === "Active Bidding Found") {
                               $('#auctionId').val(auctionId);
    $('#stateId').val(stateId);

                    $.ajax({
                        url: `http://localhost:8085/api/auction/print2/${auctionId}/${stateId}`,
                        method: "GET",
                        success: function (packResponse) {
    //                                         let table0 = packResponse.Table;
    // alert(JSON.stringify(table0, null, 2)); // pretty prints the array of objects

                                if (packResponse.Table && packResponse.Table.length > 0) {
                                $('#view_product').show();
                                

                                packResponse.Table.forEach(function (row) {
                                    $('.cards').append(`
                                        <div class="card" style="margin:10px; border:1px solid #ccc; padding:15px; border-radius:8px; text-align:center;">
                                            <label class="label-bill" style="font-weight:bold;">
                                                ${row.bench_mark_value ?? '0.00'}
                                            </label>
                                            <div class="weight">
                                                <i class="fa-solid fa-weight-hanging" style="font-size:60px; color:gold;"></i>
                                                <p class="weight-count" style="font-size:20px; font-weight:bold;">
                                                    ${row.net_wt ?? '0.000'}
                                                </p>
                                            </div>
                                            <button class="btn btn-outline-dark"
                                                onclick="view(
                                                    '${row.bench_mark_value}',
                                                    '${row.net_wt}',
                                                    '${row.loan_no}',
                                                    '${row.netwt_purity}',
                                                    '${row.branch_name}'
                                                )">
                                                View Pack
                                            </button>
                                        </div>
                                    `);
                                });
                            } else {
                                $('.welcome-container').hide();
                                $('.cards').html("<p>No packs found for this auction.</p>");
                                $('#nodata').show();
                            }
                        },
                        error: function () {
                            $('.cards').html("<p>Failed to fetch auction packs.</p>");
                        }
                    });
                }

                // === CASE 3: Bidding Finalised ===
                else if (response.Message === "Sorry Bidding Finalised. Better Luck Next Time") {
                    $('.welcome-container').hide();
                    let extra = response.ExtraData || [];
                    if (!extra || extra.length === 0) {
                        $('.cards').html(`<p>${response.Message || "No data available."}</p>`);
                        $('#nodata').show();
                        return;
                    }

                    let extraHeaders = Object.keys(extra[0]);
                    let extraTable = `
                        <div class="form-group" style="width:100%; display:flex; flex-direction:column; margin-top:20px; overflow-x:auto;">
                            <h4 style="text-align:center;">Finalised Bidding Summary</h4>
                            <div style="width:100%; overflow-x:auto;">
                                <table class="table table-bordered text-center" style="width:100%; max-width:100%; table-layout:auto; white-space:nowrap;">
                                    <thead class="table-light">
                                        <tr>${extraHeaders.map(h => `<th>${h}</th>`).join('')}</tr>
                                    </thead>
                                    <tbody>
                                        ${extra.map(row => `
                                            <tr>${extraHeaders.map(h => `<td>${row[h] ?? ''}</td>`).join('')}</tr>
                                        `).join('')}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    `;
                    $('.cards').html(extraTable);
                }

                // === CASE 4: Anything else ===
                else {
                    $('.welcome-container').hide();
                    $('#nodata').show();
                }
            },
            error: function () {
                $('.welcome-container').hide();
                $('.cards').html("<p>Failed to fetch auction details.</p>");
                $('#nodata').show();
            }
        });
    });



function view(benchmark, net_wt, loan_no, netwt_purity, branch_name) {
   

    $.ajax({
        url: "http://localhost:8085/api/auction/print_popup/" + loan_no,
        method: "GET",
        success: function (response) {
               $("#product_deatiled").modal('show');
            console.log(response);
            let imgHtml =""
            let firstde = ""
           let secondde = ""
            $('.modal-title').text("Bench Mark : " + benchmark);
            firstde +=`
                <tr style="text-align:center !important;">
            
             <td style="width:25%; text-align:center">
                 ${loan_no}
           </td>
           
            <td style="width:25%; text-align:center">
                 ${net_wt}
            </td>
       
    
           
            <td style="width:25%; text-align:center">
                ${netwt_purity}
            </td>
    
        
           
            <td style="width:25%; text-align:center">
             ${branch_name}
            </td>
           </tr>
            `;
          if (response.Images && response.Images.length > 0) {
            
    response.Images.forEach(function (img) {
        // prepend the base64 header
        imgHtml += `<img src="data:image/jpeg;base64,${img.image_orna}" 
                        style="width:250px;height:100px;margin:5px;" id="image-pro">`;
    });
} else {
    imgHtml = "<p>No images found</p>";
}
     if (response.LoanDetails && response.LoanDetails.Table.length > 0) {
    response.LoanDetails.Table.forEach(function(details){
        secondde += `
       
        <tr>
           <td >${details.Ornament}</td>
           <td >${details.Count}</td>
            <td >${details.Purity}</td>
        </tr>
       
        `;
    });
}


            $("#product_image").html(imgHtml);
            $("#first-details").html(firstde);
              $("#second-details").html(secondde);
            
          
        },
        error: function (xhr, status, error) {
            console.error("Error fetching images:", error);
        }
    });
}
