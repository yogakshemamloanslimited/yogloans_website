</script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/exceljs@4.3.0/dist/exceljs.min.js"></script>
<script>
    async function exportModalToExcelWithImage() {
        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet("Product Details");

        sheet.addRow(["Product Details"]);
        sheet.addRow([]);

        // Add image
        const imgTag = document.querySelector('#product_image img');
        if (imgTag) {
            const base64 = imgTag.src.split(',')[1];
            const imageId = workbook.addImage({
                base64: base64,
                extension: 'jpeg',
            });
            sheet.addImage(imageId, {
                tl: { col: 0, row: 1 },
                ext: { width: 300, height: 150 }
            });
            sheet.addRow([]);
        }

        // Add table data
        sheet.addRow(["Loan No", "Net Weight", "Purity", "Branch"]);
        document.querySelectorAll('#first-details tr').forEach(row => {
            const cells = Array.from(row.querySelectorAll('td')).map(td => td.innerText.trim());
            sheet.addRow(cells);
        });

        sheet.addRow([]);
        sheet.addRow(["Ornament", "Count", "Purity"]);
        document.querySelectorAll('#second-details tr').forEach(row => {
            const cells = Array.from(row.querySelectorAll('td')).map(td => td.innerText.trim());
            sheet.addRow(cells);
        });

        // Save the Excel file
        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = "Product_Details_With_Image.xlsx";
        link.click();
    }
        function exportModalToExcel() {
        // Get the table inside modal
        var table = document.querySelector('#product .modal-body table');

        if (!table) {
            alert("No data to export!");
            return;
        }

        // Convert table to workbook using SheetJS
        var wb = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });

        // Download Excel file
        XLSX.writeFile(wb, "Product_Details.xlsx");
    }

</script>

