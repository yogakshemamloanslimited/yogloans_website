        function viewProduct(loan_no) {
        $.ajax({
            url: `${API.allapi.Printpoup}${loan_no}`,
            method: "GET",
            success: function (response) {
                $("#product_deatiled").modal('show');  // Show modal
                console.log(response);

                let imgHtml = "";
                let firstde = "";
                let secondde = "";

                // Dynamically create first details row
                if (response.LoanDetails && response.LoanDetails.Table.length > 0) {
                    const details = response.LoanDetails.Table[0]; // Assuming there's only one object in Table array

                    firstde += `
                        <tr style="text-align:center !important;">
                            <td style="width:25%; text-align:center">${details["Net Wt."]}</td>
                            <td style="width:25%; text-align:center">${details["Netwt Purity"]}</td>
                            <td style="width:25%; text-align:center">${details["branch_name"]}</td>
                        </tr>
                    `;
                }

                // Add images if available
                if (response.Images && response.Images.length > 0) {
                    response.Images.forEach(function (img) {
                        imgHtml += `<img src="data:image/jpeg;base64,${img.image_orna}"
                        style="width:250px;height:100px;margin:5px;" id="image-pro">`;
                    });
                } else {
                    imgHtml = "<p>No images found</p>";
                }

                // Second details (Ornament, Count, etc.)
                if (response.LoanDetails && response.LoanDetails.Table.length > 0) {
                    response.LoanDetails.Table.forEach(function (details) {
                        secondde += `
                            <tr>
                                <td>${details.Ornament}</td>
                                <td>${details.Count}</td>
                                <td>${details.Purity}</td>
                            </tr>
                        `;
                    });
                }

                // Populate modal content
                $("#product_image").html(imgHtml);
                $("#first-details").html(firstde);
                $("#second-details").html(secondde);
            },
            error: function (xhr, status, error) {
                console.error("Error fetching images:", error);
            }
        });

        // Image hover effect: zoom in when mouse enters image
        $(document).on("mouseenter", "#product_image img", function () {
            $("#image-pro").css({
                maxHeight: "500px",
                maxWidth: "500px",
                position: "absolute",
                top: "50%",
                left: "50%",
                transform: "translate(-50%, -50%)",
                zIndex: 9999
            });
        });

        // Image click effect: reset size when clicked
        $(document).on("click", "#product_image img", function () {
            $("#image-pro").css({
                position: "relative",
                maxHeight: "100px",
                maxWidth: "250px",
                top: "0%",
                left: "0%",
                transform: "translate(0%, 0%)",
                zIndex: "auto"
            });
        });
    }

</script>
<script>
    async function exportModalToExcelWithImage() {
        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet("Product Details");

        sheet.addRow(["Product Details"]);
        sheet.addRow([]);

        // Add image
        const imgTag = document.querySelector('#product_image img');
        if (imgTag) {
            const base64 = imgTag.src.split(',')[1];
            const imageId = workbook.addImage({
                base64: base64,
                extension: 'jpeg',
            });
            sheet.addImage(imageId, {
                tl: { col: 0, row: 1 },
                ext: { width: 300, height: 150 }
            });
            sheet.addRow([]);
        }

        // Add table data
        sheet.addRow(["Loan No", "Net Weight", "Purity", "Branch"]);
        document.querySelectorAll('#first-details tr').forEach(row => {
            const cells = Array.from(row.querySelectorAll('td')).map(td => td.innerText.trim());
            sheet.addRow(cells);
        });

        sheet.addRow([]);
        sheet.addRow(["Ornament", "Count", "Purity"]);
        document.querySelectorAll('#second-details tr').forEach(row => {
            const cells = Array.from(row.querySelectorAll('td')).map(td => td.innerText.trim());
            sheet.addRow(cells);
        });

        // Save the Excel file
        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = "Product_Details_With_Image.xlsx";
        link.click();
    }
    function exportModalToExcel() {
        // Get the table inside modal
        var table = document.querySelector('#product .modal-body table');

        if (!table) {
            alert("No data to export!");
            return;
        }

        // Convert table to workbook using SheetJS
        var wb = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });

        // Download Excel file
        XLSX.writeFile(wb, "Product_Details.xlsx");
    }
             function toggleFullscreen() {
            let modalDialog = document.querySelector('#bidding-details .modal-dialog');
            let icon = document.querySelector('#fullscreen-icon');

            if (modalDialog.classList.contains('modal-fullscreen')) {
                // Revert to original size
                modalDialog.classList.remove('modal-fullscreen');
                modalDialog.classList.add('modal-lg');

                // Change icon
                icon.classList.remove('fa-compress');
                icon.classList.add('fa-expand');
            } else {
                // Make fullscreen
                modalDialog.classList.add('modal-fullscreen');
                modalDialog.classList.remove('modal-lg');

                // Change icon
                icon.classList.remove('fa-expand');
                icon.classList.add('fa-compress');
            }
        }
            // After populating cards and select
         $('#loan_no_select').on('change', function () {
        const selectedLoan = $(this).val();

        if (!selectedLoan || selectedLoan === "0") {
            $('.cards .card').show();
            return;
        }

        $('.cards .card').hide(); // hide all first
        $(`.cards .card[data-loan="${selectedLoan}"]`).show(); // show only the matching one
    });

           $('#site-search').on('input', function () {
        const query = $(this).val().trim();

        if (!query) {
            // Show all cards if input is empty
            $('.cards .card').show();
            return;
        }

        // Filter cards that contain the query in their loan number
        $('.cards .card').each(function () {
            const loanNo = $(this).data('loan'); // using data-loan attribute
            if (loanNo.toString().includes(query)) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
    });
     function biddnow() {
        var auctionId = $('#auctionId').val();
        var stateId = $('#stateId').val();

        $.ajax({
            url: `${API.allapi.Auctionprint2}${auctionId}/${stateId}`,
            method: "GET",
            success: function (packResponse) {
                console.log("Full API Response:", packResponse);
                let benchmark_gram = packResponse.benchmark_gram[0]?.benchmark_gram;

                $('#benchvalue').val(benchmark_gram);
                let table0 = packResponse.branches;
                if (!table0 || table0.length === 0) {
                    $('#bidding .modal-body').html("<p>No branches found.</p>");
                    $('#bidding').modal('show');
                    return;
