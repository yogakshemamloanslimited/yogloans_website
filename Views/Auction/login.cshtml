
@{
    Layout = null;
    ViewData["Title"] = "Auction Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>



    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>


    <div class="main-content">
        <form class="login">

            <h2>Welcome, Bidder!</h2>
            <p>Please log in</p>

            <div class="form-group">

                <input class="form-control" placeholder="Register Mobile Number" id="mobile" />
                <span class="text-danger"></span>
            </div>

            <div class="form-group">

                <input class="form-control" placeholder="Enter Secret Code " id="otp" />
                <span class="text-danger"></span>
            </div>

            <div asp-validation-summary="All" class="text-danger"></div>


            <button type="button" class="btn btn-primary" id="logme">Log In</button>
        </form>
    </div>
  <div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-danger">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="errorModalLabel">Oops</h5>
     @*    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button> *@
      </div>
      <div class="modal-body">
        <p id="errorMessage"></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
    <style>

      .main-content {
            margin-left: 0px;
            padding-top: 0px;
            min-height: calc(0vh - 0px);
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 700px;
        }

.login {
 @*  margin: 20px auto; *@
 @*
  max-width: 300px; *@
   padding: 40px 50px;
  width: 30%    ;
  border-radius: 5px;
  background: #fff;
@*   box-shadow: 1px 1px 1px #666; *@
box-shadow: 0px 0px 2px 0px #c0c0c0;
}
  .login input {
    width: 100%;
    display: block;
    box-sizing: border-box;
    margin: 10px 0;
    padding: 14px 12px;
    margin-bottom: 20px;
    font-size: 16px;
    border-radius: 2px;
    font-family: Raleway, sans-serif;
  }

.login input[type=text],
.login input[type=password] {
  border: 1px solid #c0c0c0;
  transition: .2s;
}

.login input[type=text]:hover {
  border-color: #044697;
  outline: none;
  transition: all .2s ease-in-out;
}

.login input[type=submit] {
  border: none;
  background: #044697;
  color: white;
  font-weight: bold;
  transition: 0.2s;
  margin: 20px 0px;
}

.login input[type=submit]:hover {

  background-color: #044697;
}

  .login h2 {
    margin: 20px 0 0;
    color: #044697;
    font-size: 28px;
  }

.login p {
  margin-bottom: 40px;
}

.links {
  display: table;
  width: 100%;
  box-sizing: border-box;
  border-top: 1px solid #c0c0c0;
  margin-bottom: 10px;
}

.links a {
  display: table-cell;
  padding-top: 10px;
}

.links a:first-child {
  text-align: left;
}

.links a:last-child {
  text-align: right;
}

  .login h2,
  .login p,
  .login a {
    text-align: justify;
  }

.login a {
  text-decoration: none;
  font-size: .8em;
}

.login a:visited {
  color: inherit;
}

.login a:hover {
  text-decoration: underline;
}
@@media(max-width:900px){
    form{
        width:100%;
    }
}
    </style>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    $('#logme').click(function() {
        var mobile = $('#mobile').val();
        var otp = $('#otp').val();

        $.ajax({
            // url: "http://localhost:8085/api/auction/login?mobile=" + mobile + "&otp=" + otp,
            url:API.allapi.Auctonlogin,
            method: "GET",
             data:{mobile : mobile, otp:otp},
            success: function (response) {
                let codeValue = 0; // default

                if (response.outputMessage === "1") {
                    codeValue = 1;
                } 
                else if (response.outputMessage === "2") {
                    codeValue = 2;
                } 
                else {
                    codeValue = 0;
                }

                // Set the session via POST
                $.ajax({
                    url: '@Url.Action("SetModuleId", "Home")',
                    method: 'POST',
                   data: { code: codeValue, mobile: mobile, otp: otp },

                    success: function () {
                        // After setting session, take action based on outputMessage
                        if (response.outputMessage === "1") {
                            window.location.href = '/Auction';
                        } 
                        else if (response.outputMessage === "2") {
                                             window.location.href = '/Auctineer';
                        } 
                        else {
                            $('#errorMessage').text(response.outputMessage);

                            var errorModal = new bootstrap.Modal(document.getElementById('errorModal'), {
                                backdrop: 'static',
                                keyboard: false
                            });
                            errorModal.show();
                        }
                    },
                    error: function () {
                        alert('Failed to set session.');
                    }
                });
            },
            error: function (xhr, status, error) {
                console.error(error);
                alert("An error occurred: " + error);
            }
        });
    });
});


</script>


