
<partial name="contactcard" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
<section class="contact" style="display:flex; justify-content:center; width:100%; margin-top:20px;">
    <div class="card" style="width:90%; display:flex; flex-direction:row; padding:0px; justify-content:center; align-items:center; height:100%;">
        <form id="enquiryForm" class="styled-form">
            <h2>Get In Touch</h2>

            <!-- ROW 1: NAME / EMAIL / PHONE -->
            <div class="row">
                <div class="col">
                    <div class="input-box">
                        <input type="text" id="enquiry_name" name="enquiry_name" required>
                        <label for="enquiry_name">Full Name</label>
                    </div>
                </div>

                <div class="col">
                    <div class="input-box">
                        <input type="email" id="email_id" name="email_id" required>
                        <label for="email_id">Email Address</label>
                    </div>
                </div>

                <div class="col">
                    <div class="input-box">
                        <input type="text" id="contact_no" name="contact_no" required>
                        <label for="contact_no">Mobile Number</label>
                    </div>
                </div>
            </div>

            <!-- ROW 2: ADDRESS FULL WIDTH -->
            <div class="input-box full">
                <textarea id="enquiry_address" name="enquiry_address" required></textarea>
                <label for="enquiry_address">Full Address</label>
            </div>

            <button type="submit" class="btn col-6" style="margin-top:10px;">Send Enquiry</button>
        </form>
            <div class="" style="width:40%;" id="map-section">
                <partial name="map" />
            </div>

    </div>
</section>

<style>
    #enquiryForm{
        width:60%;
    }
    /* FORM MAIN */
    .styled-form {
        width: 100%;
      /*   max-width: 900px;
        margin: auto; */
        padding: 30px 25px;
        background: #ffffff;
        border-radius: 12px;
        font-family: "Poppins", sans-serif;
    }

        .styled-form h2 {
            text-align: center;
            margin-bottom: 25px;
            color: #333;
            font-weight: 600;
        }

    /* GRID LAYOUT */
    .row {
        display: flex;
     /*    gap: 20px;
        margin-bottom: 25px; */
    }

    .col {
        flex: 1;
    }

    /* FULL WIDTH ROW */
    .input-box.full {
        width: 100%;
    }

    /* FLOATING LABEL INPUT BOX */
    .input-box {
        position: relative;
        width: 100%;
    }

        .input-box input,
        .input-box textarea {
            width: 100%;
            padding: 14px;
            border: 2px solid #ccc;
          /*   border-radius: 8px; */
            font-size: 15px;
            background: transparent;
            outline: none;
            transition: 0.3s ease;
            resize: none;
        }

        .input-box textarea {
            height: 90px;
        }

        /* Floating label */
        .input-box label {
            position: absolute;
            top: 14px;
            left: 14px;
            background: #fff;
            padding: 0 6px;
            color: #777;
            font-size: 15px;
            pointer-events: none;
            transition: 0.3s ease;
        }

        /* On focus OR typed */
        .input-box input:focus,
        .input-box textarea:focus {
            border-color: #B4181E;
        }

            .input-box input:focus + label,
            .input-box input:not(:placeholder-shown) + label,
            .input-box textarea:focus + label,
            .input-box textarea:not(:placeholder-shown) + label {
                top: -9px;
                font-size: 12px;
                color: #B4181E;
            }

    /* SUBMIT BUTTON */
    .styled-form .btn {
        width: 100%;
        padding: 14px;
        background: #B4181E;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        transition: 0.3s ease;
    }

        .styled-form .btn:hover {
            background: #8d1217;
        }
        @@media(max-width:900px){
            .card{
            flex-direction: column !important;
            width:100% !important;
            }

        #enquiryForm {
            width: 100%;
        }

        .input-box.full {
            width: 100%;
            margin: 10px;
        }

        .col {
          
            width: 100%;
            margin: 10px;
        }

        .styled-form .btn {
            margin: 10px;
            
        }

        #map-section{
            width:100% !important;
        }

        .form-group {
            flex-direction:column;
            justify-content:center  ;
            align-items:center;
        }

            .form-group .card {
                width: 90% !important;
            }
        }

</style>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
    $(document).ready(function() {
        $('#enquiryForm').on('submit', function(e) {
            e.preventDefault();

            var data = {
                enquiry_name: $('#enquiry_name').val(),
                enquiry_address: $('#enquiry_address').val(),
                contact_no: $('#contact_no').val(),
                email_id: $('#email_id').val(),
                created_date: new Date().toISOString()
            };

            $.ajax({
                url: API.allapi.enquiry,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thank you!',
                        text: response.Message || 'Your enquiry has been submitted successfully!',
                        showConfirmButton: false,
                        timer: 2000,
                        background: '#f0fff0',
                        color: '#155724',
                        iconColor: '#28a745',
                        position: 'center',
                        showClass: {
                            popup: 'animate__animated animate__fadeInDown'
                        },
                        hideClass: {
                            popup: 'animate__animated animate__fadeOutUp'
                        }
                    });
                    $('#enquiryForm')[0].reset();
                },
                error: function(xhr) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Error submitting enquiry. Please try again.'
                    });
                }
            });
        });
    });
    </script>