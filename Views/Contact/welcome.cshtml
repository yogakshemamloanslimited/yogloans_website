     @model List<yogloansdotnet.Models.ContactWelcome> 

@{
    var firstWelcome = Model?.FirstOrDefault();
    string imageBase641 = null;
    if (firstWelcome?.Image1 != null)
    {
        imageBase641 = "data:image/png;base64," + Convert.ToBase64String(firstWelcome.Image1);
    }

    string imageBase642 = null;
    if (firstWelcome?.Image2 != null)
    {
        imageBase642 = "data:image/png;base64," + Convert.ToBase64String(firstWelcome.Image2);
    }

}

  <section class="welcome-container"
         style="background-image: url(@(imageBase641))" id="welcome-desktop">
        <h1 style="visibility:hidden;">Contact Us
            </h1><!--    <p id="sub">Experience Door Step Gold Loan Services</p>  -->
    <div class="button">
        <h1 >
            Contact Us
        </h1>
       @*  <p><a href="javascript:history.back()" id="return-link">Home</a> - Contact Us</p> *@
     </div>
    <div class="redirect"
         onclick="window.location.href='/branch'">
        <img src="~/images/icon/find.png" class="rotating-icon" />  <p style="font-size: 18px; margin-top: 10px;" id="nearby-text"> Nearby Branches</p>
    </div>
    </section>
   
<!-- 
    <div id="spinners" style=" text-align:center; margin:20px;">
        <span style="color:black; font-size:20px;">Loading nearby branches...</span>
        <div style="border: 4px solid #f3f3f3; border-top: 4px solid #3498db; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; display:inline-block;"></div>
    </div>

    <div id="branch-list"></div> -->

   

    <section class="welcome-container"
         style="background-image: url(@(imageBase642)" id="welcome-mobile">
    <h1 style="visibility:hidden;">
        Contact Us
    </h1>
    <div class="button">
        <h1 style="">
            Contact Us
        </h1>
            @*  <p><a href="javascript:history.back()" id="return-link">Home</a>- Contact Us</p> *@
     </div>
    <div class="redirect2"
         onclick="window.location.href='/branch'">
        <img src="~/images/icon/find.png" class="rotating-icon2" />  <p style="font-size: 18px; margin-top: 10px;" id="nearby-text2"> Nearby Branches</p>
    </div>
</section>
<style>
    .welcome-container{
        height: 300px;
    }
    a{
        text-decoration:none;
        color:white;
    }
    #welcome-mobile { display: none; }
    #welcome-desktop { display: flex; }
    @@media (max-width: 767px) {
        #welcome-desktop { display: none; }
        #welcome-mobile { display: flex; }
    }

    @@keyframes rotate {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .rotating-icon {
        width: 45px;
        height: 45px;
        filter: invert(1);
        animation: rotate 2s linear infinite;
    }

    .redirect{
        width: auto;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        box-shadow: 0px 0px 1px 0px gray;
        border-top-left-radius: 32px;
        border-bottom-left-radius: 32px;
        background-color: #B4181E;
        color: white;
        position: fixed;
        right: 0%;
        gap: 15px;
        transform-origin: left top;
        z-index: 1000;
        padding: 5px;
      

    }

    .redirect {
        width: auto;
        transition: width 0.5s ease;
        cursor: pointer;
    }

        .redirect.scrolled {
            width: 55px;
            background: rgb(4, 70, 151);
        }

            /* When hovered, always expand */
            .redirect.scrolled:hover {
                width: auto;
                background-color: #B4181E;
            }

    /* Nearby text */
    #nearby-text {
        display: flex; /* default */
        opacity: 1;
        transition: opacity 0.5s ease;
    }

        #nearby-text.hidden {
            display: none;
            opacity: 0;
        }






    .rotating-icon2 {
        width: 45px;
        height: 45px;
        filter: invert(1);
        animation: rotate 2s linear infinite;
    }

    .redirect2 {
        width: auto;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        box-shadow: 0px 0px 1px 0px gray;
        border-top-left-radius: 32px;
        border-bottom-left-radius: 32px;
        background-color: #B4181E;
        color: white;
        position: fixed;
        right: 0%;
        gap: 15px;
        transform-origin: left top;
        z-index: 1000;
        padding: 5px;
        top: 11%;
    }

    .redirect2 {
        width: auto;
        transition: width 0.5s ease;
        cursor: pointer;
    }

        .redirect2.scrolled {
            width: 55px;
            background: rgb(4, 70, 151);
        }

            /* When hovered, always expand */
            .redirect2.scrolled:hover {
                width: auto;
                background-color: #B4181E;
            }

    /* Nearby text */
    #nearby-text2 {
        display: flex; /* default */
        opacity: 1;
        transition: opacity 0.5s ease;
    }

        #nearby-text2.hidden {
            display: none;
            opacity: 0;
        }
     
</style>
<script>
         $(window).on('scroll', function() {
        const scrollTop = $(this).scrollTop();

        if (scrollTop > 50) {
            $('.redirect').addClass('scrolled');
            $('#nearby-text').addClass('hidden');
        } else {
            $('.redirect').removeClass('scrolled');
            $('#nearby-text').removeClass('hidden');
        }
    });

    // Show nearby text on hover
    $('.redirect').hover(
        function() {
            $('#nearby-text').removeClass('hidden'); // show text
        },
        function() {
            if ($(window).scrollTop() > 50) {
                $('#nearby-text').addClass('hidden'); // hide text again if scrolled
            }
        }
    );





     $(window).on('scroll', function() {
        const scrollTop = $(this).scrollTop();

        if (scrollTop > 50) {
            $('.redirect2').addClass('scrolled');
            $('#nearby-text2').addClass('hidden');
        } else {
            $('.redirect2').removeClass('scrolled');
            $('#nearby-text2').removeClass('hidden');
        }
    });

    // Show nearby text on hover
    $('.redirect2').hover(
        function() {
            $('#nearby-text2').removeClass('hidden'); // show text
        },
        function() {
            if ($(window).scrollTop() > 50) {
                $('#nearby-text2').addClass('hidden'); // hide text again if scrolled
            }
        }
    );



    const link = document.getElementById('return-link');
    const ref = document.referrer;

    if (ref) {
        // Create a temporary anchor to parse the URL
        const url = new URL(ref);

        // Get the last part of the path (e.g., 'investors' from '/investors')
        let pageName = url.pathname.split('/').filter(Boolean).pop() || 'Home';

        // Make it user-friendly
        pageName = pageName.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

        link.textContent = pageName;
        link.href = ref;
    }
       
</script>