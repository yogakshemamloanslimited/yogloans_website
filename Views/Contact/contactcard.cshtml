<style>
    .contact-card {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
        padding: 20px;
        align-items: start;
    }

        .contact-card .card {
        background: #fff;
        padding: 6px;
        border-radius: 0px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: .3s;
        text-align: center;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .icon-top {
        margin-bottom: 10px;
        color: #B4181E;
        margin-top: 10px;
    }

    .title {
        font-size: 16px;
        font-weight: 600;
        min-height: 46px;
        margin-bottom: 12px;
    }

    .toggle-btn, .hide-btn {
        background: #B4181E;
        color: #fff;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        cursor: pointer;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: .3s;
        margin-top:20px;
    }

    .arrow-icon {
        transition: .3s ease;
    }

    /* Smooth slide animation container */
    .info-section {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: max-height .4s ease, opacity .3s ease;
        margin-top: 12px;
    }

        /* When visible */
        .info-section.active {
            opacity: 1;
            max-height: 500px; /* Enough for any content */
        }

    .contact-card .card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 30px rgba(0,0,0,0.3);
    }

    .info {
        width: 100%;
        border-top: 1px solid #ddd;
        padding-top: 10px;
        border-spacing: 0 8px;
    }

        .info td {
            font-size: 14px;
            text-align: start;
            padding-left: 5px;
            padding-top: 20px;
        }

        .info i {
            width: 18px;
            font-size:18px;
        }

    /* FIX KEYFRAMES */
    @@keyframes fadeIn {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }
</style>
<script>
    const cards = document.querySelectorAll(".card");

    cards.forEach(card => {
        const showBtn = card.querySelector(".toggle-btn");
        const hideBtn = card.querySelector(".hide-btn");
        const info = card.querySelector(".info-section");

        if (!showBtn || !hideBtn) return;

        // Show card
        showBtn.addEventListener("click", () => {
            cards.forEach(c => {
                c.querySelector(".info-section").classList.remove("active");
                c.querySelector(".toggle-btn").style.display = "block";
                c.querySelector(".hide-btn").style.display = "none";
            });

            info.classList.add("active");
            showBtn.style.display = "none";
            hideBtn.style.display = "block";
        });

        // Hide card
        hideBtn.addEventListener("click", () => {
            info.classList.remove("active");
            hideBtn.style.display = "none";
            showBtn.style.display = "block";
        });
    });
</script>
