@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Redirecting to SBI...</title>
</head>
<body onload="document.forms[0].submit();">
    <form method="post" action="https://www.sbiepay.sbi/secure/AggregatorHostedListener">
        <input type="hidden" name="EncryptTrans" value="@ViewBag.EncryptTrans" />
        <input type="hidden" name="MultiAccountInstructionDtls" value="@ViewBag.MultiAccountInstructionDtls" />
        <input type="hidden" name="merchIdVal" value="@ViewBag.MID" />
        <section style="position:absolute; left:50%; top:50%; transform:translate(-50%, -50%)">
            <img src="~/images/Payment verify loader.gif" style="width:150px; height:150px;" />
        </section>
    </form>
</body>
</html>
