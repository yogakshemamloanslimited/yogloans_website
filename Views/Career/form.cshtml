
<link rel="stylesheet" href="~/css/career/form.css" asp-append-version="true">

<section class="application-section" id="application">
    <div class="main-content">
        <h2>Connect For Future</h2>
   <form class="application-form container" id="apply-career-form">
    <div class="row" style="width: 100%;">
        <div class="col-md-6">
            <label for="name" class="form-label">Full Name</label>
            <input type="text" id="name" name="Name" class="form-control" required placeholder="Full Name" />
        </div>
        <div class="col-md-6">
            <label for="gender" class="form-label">Gender</label>
            <select id="gender" name="Genter" class="form-select" required>
                <option value="">Select Gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
            </select>
        </div>
    </div>

    <div class="row" style="width: 100%;">
        <div class="col-md-6">
            <label for="dob" class="form-label">Date of Birth</label>
            <input type="date" id="dob" name="DOB" class="form-control" required />
        </div>
        <div class="col-md-6">
            <label for="mobile" class="form-label">Mobile No</label>
            <input type="text" id="mobile" name="Mobile_no" class="form-control" required placeholder="Mobile No" />
        </div>
    </div>

    <div class="row" style="width: 100%;">
        <div class="col-md-6">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="Email" class="form-control" required placeholder="Email" />
        </div>
        <div class="col-md-6">
            <label for="qf" class="form-label">Qualification</label>
            <select name="qualification_id" id="qfs" class="form-control">
                <option value="">Select Qualification</option>
            </select>
        </div>
    </div>

    <div class="row" style="width: 100%;">
        <div class="col-md-6">
            <label for="experience" class="form-label">Experience</label>
            <input type="text" id="experience" name="Experience" class="form-control" placeholder="Experience" />
        </div>
        <div class="col-md-6">
            <label for="house" class="form-label">House No</label>
            <input type="text" id="house" name="House" class="form-control" placeholder="House No" />
        </div>
    </div>

    <div class="row" style="width: 100%;">
        <div class="col-md-6">
            <label for="pin" class="form-label">Pin Code</label>
            <input type="text" id="pin" name="pin" class="form-control" placeholder="Pin Code" />
        </div>
       
        <div class="col-md-6">
            <label for="state" class="form-label">State</label>
            <input type="text" id="state2" name="state" class="form-control"  placeholder="State" />
        </div>
    </div>

    <div class="row" style="width: 100%;">
        
        <div class="col-md-6">
            <label for="district" class="form-label">District</label>
            <input type="text" id="district2" name="district" class="form-control"  placeholder="District" />
        </div>
        <div class="col-md-6">
            <label for="resume" class="form-label">Upload Resume</label>
            <input type="file" id="Resume" name="Resume" class="form-control" />
        </div>
    </div>

    <div class="row" style="width: 100%;">
        <div class="col-md-12 text-center">
            <button type="submit" class="btn btn-primary px-4">Submit</button>
        </div>
    </div>
                
</form>


    </div>
</section>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    

 
$.ajax({
    url : API.allapi.CareerQualification,
    method : "GET",
    success : function (response){
        const data = response ;

        console.log("response",response);
        data.forEach(function(item) {
         
       $('#qfs').append(` <option value="${item.Qualification_id}">${item.Qualification_name}</option> `);});
    }
});




        $('#apply-career-form').on('submit', function (e) {
        e.preventDefault();

        var formData = new FormData(this);

        console.log('--- Form Data Entries ---');
        for (var pair of formData.entries()) {
            console.log(pair[0] + ':', pair[1]);
        }

        $.ajax({
            url: API.allapi.CareerApply,
            type: 'POST',
            data: formData,
            enctype: 'multipart/form-data',
            processData: false,
            contentType: false,
            cache: false,

            success: function (response) {
                
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: 'Candidate Profile Saved Successfully!'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    alert('Candidate Profile Saved Successfully!');
                    $('#candidateModal').modal('hide');
                    $('form')[0].reset();
                }
            },

            error: function (xhr, status, error) {
                console.error("Full Error:", xhr.responseText);

                let errorMsg = "Something went wrong.";

                try {
                    let response = JSON.parse(xhr.responseText);

                    // 1) Exception message
                    if (response.ExceptionMessage) {
                        errorMsg = response.ExceptionMessage;

                    // 2) Common 'Message'
                    } else if (response.Message) {
                        errorMsg = response.Message;

                    // 3) OAuth / Generic errors
                    } else if (response.error_description) {
                        errorMsg = response.error_description;
                    } else if (response.error) {
                        errorMsg = response.error;

                    // 4) ASP.NET Core ModelState errors
                    } else if (response.errors) {
                        errorMsg = Object.values(response.errors)
                            .flat()
                            .join("\n");

                    // 5) Custom "Errors" array
                    } else if (response.Errors && Array.isArray(response.Errors)) {
                        errorMsg = response.Errors.join("\n");
                    }

                } catch (e) {
                    console.log("JSON parse failed:", e);

                    // Fallback → raw text
                    errorMsg = xhr.responseText || "Request failed.";
                }

                // Show alert
                if (typeof Swal !== "undefined") {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: errorMsg
                    });
                } else {
                    alert(errorMsg);
                }
            }
        });
    });


// Ensure SweetAlert2 is included
if (typeof Swal === 'undefined') {
    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11';
    script.onload = function() { console.log('SweetAlert2 loaded'); };
    document.head.appendChild(script);
}

</script>


