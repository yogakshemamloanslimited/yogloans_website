
@{
    Layout = null;
    ViewData["Title"] = "Greevence Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <script src="~/js/api.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<style>

    .main-content {
        margin-left: 0px;
        padding-top: 0px;
        min-height: calc(0vh - 0px);
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 700px;
    }

    .login {
    @*  margin: 20px auto; *@
    @*
  max-width: 300px; *@
   padding: 40px 50px;
        width: 30%;
        border-radius: 5px;
        background: #fff;
    @*   box-shadow: 1px 1px 1px #666; *@
box-shadow: 0px 0px 2px 0px #c0c0c0;
    }

        .login input {
            width: 100%;
            display: block;
            box-sizing: border-box;
            margin: 10px 0;
            padding: 14px 12px;
            margin-bottom: 20px;
            font-size: 16px;
            border-radius: 2px;
            font-family: Raleway, sans-serif;
        }

            .login input[type=text],
            .login input[type=password] {
                border: 1px solid #c0c0c0;
                transition: .2s;
            }

                .login input[type=text]:hover {
                    border-color: #044697;
                    outline: none;
                    transition: all .2s ease-in-out;
                }

            .login input[type=submit] {
                border: none;
                background: #044697;
                color: white;
                font-weight: bold;
                transition: 0.2s;
                margin: 20px 0px;
            }

                .login input[type=submit]:hover {
                    background-color: #044697;
                }

        .login h2 {
            margin: 20px 0 0;
            color: #044697;
            font-size: 28px;
        }

        .login p {
            margin-bottom: 40px;
        }

    .links {
        display: table;
        width: 100%;
        box-sizing: border-box;
        border-top: 1px solid #c0c0c0;
        margin-bottom: 10px;
    }

        .links a {
            display: table-cell;
            padding-top: 10px;
        }

            .links a:first-child {
                text-align: left;
            }

            .links a:last-child {
                text-align: right;
            }

    .login h2,
    .login p,
    .login a {
        text-align: justify;
    }

    .login a {
        text-decoration: none;
        font-size: .8em;
    }

        .login a:visited {
            color: inherit;
        }

        .login a:hover {
            text-decoration: underline;
        }

    @@media(max-width:900px) {
        form {
            width: 100%;
        }
        .login{
            width:100%;
        }

            .login h2 {
                font-size:20px;
            }

            .login input {
                font-size:10px;
            }

    }
</style>
<body>
    <input type="hidden" id="customer_id_getting" />

    <div class="main-content">
        <form class="login">

            <h2>Grievance Customer Login</h2>
            <p id="taxFormMsg">We’re Here to Help</p>
          
        
            <div class="form-group">

                <input class="form-control" placeholder="Enter Registered Mobile Number " id="mobileNo" />
                <span class="text-danger"></span>
            </div>
            <div class="otp-group" style="display:none;" id="otpSection">
                <div class="form-group">

                    <input class="form-control" placeholder="Enter Otp" id="otpInput" />
                    <span class="text-danger"></span>
                </div>
                <div class="form-group" style="display:flex; flex-direction:column; align-items:center; justify-content:center; width:100%;">
                    <button  class="btn btn-primary" id="verifyOtpBtn">Verify Otp  <i class="fa fa-cog fa-w-16 fa-spin" id="spin-very-load" style="display:none"></i></button>
                    <a style="cursor:pointer; font-size:15px; margin-top:10px; " id="resendOtpBtn">Resend Otp</a>
                </div>
            </div>
           
           
            <div class="form-group" style="display:flex;  align-items:center; justify-content:center;">

                <button  class="btn btn-primary" id="sendOtpBtn">
                    Send Otp  <i class="fa fa-cog fa-w-16 fa-spin" id="spin-load" style="display:none"></i>
                </button>
            </div>
        </form>
    </div>
  <div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-danger">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="errorModalLabel">Oops</h5>
     @*    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button> *@
      </div>
      <div class="modal-body">
        <p id="errorMessage"></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
  
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {

            function extractErrorMessage(xhr) {
                let msg = 'Error occurred';
                try {
                    const json = JSON.parse(xhr.responseText);
                    msg = json.Message || json.message || msg;
                } catch (e) {
                    msg = xhr.responseText || msg;
                }
                return msg.replace(/[{}"]/g, '').trim(); // remove {} and quotes if any remain
            }

            // ====================== SEND OTP ======================
            $('#sendOtpBtn').on('click', function (e) {
                e.preventDefault();

                const mobile = $('#mobileNo').val();
                $('#taxFormMsg').text('');
                $('#spin-load').show();

                $.ajax({
                    url: API.allapi.Sendotp + '?mobile=' + encodeURIComponent(mobile),
                    type: 'GET',
                    success: function (res) {
               
                        if (res.success) {
                            slNo = res.slNo;
                            $('#customer_id_getting').val(res.customerId || '');
                            $('#otpSection').show();
                            $('#sendOtpBtn').hide();
                            $('#taxFormMsg').text(res.message).css('color', 'green');
                        } else {
                            $('#taxFormMsg').text(res.message || 'Failed to send OTP').css('color', 'red');
                        }
                        $('#spin-load').hide();
                    },
                    error: function (xhr) {
                        const msg = extractErrorMessage(xhr);
                        $('#taxFormMsg').text(msg).css('color', 'red');
                        $('#spin-load').hide();
                    }
                });
            });

            // ====================== VERIFY OTP ======================
            $('#verifyOtpBtn').on('click', function (e) {
                e.preventDefault();

                const customerId = $('#customer_id_getting').val();
                const mobileNo = $('#mobileNo').val();
                const otp = $('#otpInput').val();

                $('#spin-very-load').show();

                if (!slNo) {
                    $('#taxFormMsg').text('Session expired. Please try again.').css('color', 'red');
                    $('#spin-very-load').hide();
                    return;
                }

                $.ajax({
                    url: API.allapi.verifyotp,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ CustomerId: customerId, MobileNo: mobileNo, Otp: otp, SlNo: slNo }),
                    success: function (res) {
                        if (!res) {
                            $('#taxFormMsg').text('No data returned from server.').css('color', 'red');
                            $('#spin-very-load').hide();
                            return;
                        }

                        if (res.success) {
                            $.ajax({
                                url: '@Url.Action("Customeraddress", "Home")',
                                type: 'POST',
                                data: {
                                    address: null,
                                    CustomerId: customerId
                                },
                                success: function (response) {
                                    console.log("Session set response:", response);

                                    if (response.success) {
                                        setTimeout(() => {
                                            window.location.href = `/Grievance`;
                                        }, 300);
                                    } else {
                                        console.warn("Session not set:", response.message);
                                    }
                                },
                                error: function (xhr) {
                                    const msg = extractErrorMessage(xhr);
                                    console.error("Session set failed:", msg);
                                }
                            });

                            $('#taxFormMsg').text(res.message).css('color', 'green');
                        } else {
                            $('#taxFormMsg').text('OTP verification failed').css('color', 'red');
                        }

                        $('#spin-very-load').hide();
                    },
                    error: function (xhr) {
                        const msg = extractErrorMessage(xhr);
                        $('#taxFormMsg').text(msg).css('color', 'red');
                        $('#spin-very-load').hide();
                    }
                });
            });

            // ====================== RESEND OTP ======================
            $('#resendOtpBtn').on('click', function (e) {
                e.preventDefault();

                const customerId = $('#customer_id_getting').val();
                const mobileNo = $('#mobileNo').val();

                if (!slNo) {
                    $('#taxFormMsg').text('Session expired. Please try again.').css('color', 'red');
                    return;
                }

                $.ajax({
                    url: API.allapi.resendOtp,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ CustomerId: customerId, MobileNo: mobileNo, SlNo: slNo }),
                    success: function (res) {
                        if (res.success) {
                            $('#taxFormMsg').text(res.message).css('color', 'green');
                        } else {
                            $('#taxFormMsg').text(res.message || 'Failed to resend OTP').css('color', 'red');
                        }
                    },
                    error: function (xhr) {
                        const msg = extractErrorMessage(xhr);
                        $('#taxFormMsg').text(msg).css('color', 'red');
                    }
                });
            });
        });
    </script>


</body>
</html>
