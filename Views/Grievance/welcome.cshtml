	$('#type').on("change", function() {
        
    const selectedLoanType = $(this).find(':selected').data('loan_type');
      
        $('#loanTableContainer').empty();
     $('#loan_no_sec').hide();
    const customer_id = '@Context.Session.GetString("CustomerId")';

		$.ajax({
              url: API.allapi.loandetails,
			  method: "GET",
              data: { customer_id : customer_id , loan_type: selectedLoanType },
			  success: function (res) {
                  
            $('#loanTableContainer').show();

            
                   const data = res.dt?.Table || [];
           const table = $('<table>').addClass('table table-striped text-center table-bordered ');
    const thead = $('<thead>').append('<tr><th>Select Loan</th><th>Loan</th><th>Loan No</th><th>Loan Date</th></tr>');
    const tbody = $('<tbody>');

    $.each(data, function (_, item) {
        const tr = $('<tr>');

        // ✅ Create a select button
        const selectBtn = $('<button>')
            .addClass('btn btn-sm btn-primary')
            .text('Select')
            .on('click', function() {
                $('#loanTableContainer').hide();
                $('#loanTableContainer').empty();
                $('#loan_no_sec').show();
                $('#loan_no_sec').empty();
                $('#loan_no_sec').append(` <label for="loan_no" class="form-label mb-3  fw-semibold">Selected Loan Number</label>
                   <input
      type="text"
      readonly
      id="loan_no"
      class="form-control"
      value="${item.Loan_No}"
      style="border: none; outline: none; box-shadow: none; background-color: transparent; pointer-events: none;"
    />
    `);
           
            });

        // ✅ Build each cell
        $('<td>').append(selectBtn).appendTo(tr);
        $('<td>').text(item.Loan).appendTo(tr);
        $('<td>').text(item.Loan_No).appendTo(tr);
        $('<td>').text(new Date(item.Loan_Date).toLocaleDateString()).appendTo(tr);

        tbody.append(tr);
    });

    table.append(thead).append(tbody);
    $('#loanTableContainer').empty().append(table);

				  // Handle the response as needed
			  },
			  error: function (xhr) {
				  let msg = 'Error occurred';
				  try {
					  const json = JSON.parse(xhr.responseText);
					  msg = json.Message || json.message || msg;
				  } catch (e) {
					  msg = xhr.responseText || msg;
				  }
				  console.error(msg);
			  }
        });
	});
       $(document).ready(function() {
        $('input[name="messageType"]').prop('checked', false);
    });

        $("#card-form").on("submit", function (e) {
        e.preventDefault();

        var customer_id = '@Context.Session.GetString("CustomerId")';
        var loan_type = $('#type').val();
     var loan_no = $('#loan_no').val() ? $('#loan_no').val() : 0;

        var comment = $('#complainText').val();
        var fileInput = $('#fileInput')[0].files[0]; // ✅ Get actual file object

        // ✅ Build FormData object
        var formData = new FormData();
        formData.append("customer_id", customer_id);
        formData.append("loan_type", loan_type);
        formData.append("loan_no", loan_no);
        formData.append("comment", comment);

        if (fileInput) {
            formData.append("postedFile", fileInput); // ✅ attach file
        }
  
        $.ajax({
            url: API.allapi.submitgrie,
            type: "POST",
            data: formData,
            processData: false, // ✅ prevent jQuery from processing data
            contentType: false, // ✅ prevent jQuery from setting content type
            beforeSend: function () {
                $("#responseMsg").html("<span class='text-info'>Submitting grievance...</span>");
            },
            success: function (res) {
                if (res.success) {
                 
                    $("#responseMsg").html("<span class='text-success fw-bold'>" + res.message + "</span>");
                    $("#card-form")[0].reset(); 
                    $("#filePreviews").empty();
                $('#uploadStats').hide();
                 
                      $('#complainBox').hide();
                    $('#loan_no_sec').empty();
                        Swal.fire({
                    title: 'Submitted!',
                    text: res.message,
                    imageUrl: '/images/icon/sign-up.png',   // 🔹 your custom image path
                    imageWidth: 100,                        // optional
                    imageHeight: 100,                       // optional
                    imageAlt: 'Success icon',               // optional alt text
                    confirmButtonColor: '#4c6fff',          // match your theme
                    confirmButtonText: 'OK'
                    });

                } else {
                    $("#responseMsg").html("<span class='text-danger'>Failed: " + (res.message || "Error") + "</span>");
                }
            },
            error: function (err) {
                console.error(err);
                $("#responseMsg").html("<span class='text-danger'>Error submitting grievance.</span>");
            }
        });
        

    });
     // Use delegated event binding
    $(document).on('click', '#yes', function () {
        $('#complainBox').show();
        $('.exists').hide();
    });

    // Optional: handle NO button too
       $(document).on('click', '#no', function () {
        window.location.reload();
