	$(document).ready(function () {
    var customerId = '@Context.Session.GetString("CustomerId")';
            $.ajax({
        url: API.allapi.GetCustomer,
        method: "GET",
        data: { customerId: customerId },
        success: function (response) {
            console.log(response);          // Full response
            const table = response.dt?.Table; // Use optional chaining for safety

            if (table && table.length > 0) {
                const customer = table[0]; // First row
              
                console.log("Customer Name:", customer.customer_name);
                console.log("Mobile:", customer.mobile_no);
                $('#customer_name').text(customer.customer_name);
                $('#customer_email').text(customer.email_id);
                  $('#customer_email').text(customer.email_id);
                  $('#customer_mobile').text(customer.mobile_no);
            } else {
                alert("No customer data found");
            }
        },
        error: function (xhr) {
            let msg = 'Error occurred';
            try {
                const json = JSON.parse(xhr.responseText);
                msg = json.Message || json.message || msg;
            } catch (e) {
                msg = xhr.responseText || msg;
            }
        
        }
    });
  
        
	});

        function cheking1() {
             $('#loanTableContainer').empty();
               $('.exists').hide();

            var customerId = '@Context.Session.GetString("CustomerId")';
        const type = $('input[name="messageType"]:checked').val(); // get selected radio
              $.ajax({
        url: API.allapi.checkexistence,
        method: "GET",
        data: { cust_id: customerId, selected_type: type },
        success: function (res) {

            // Clear old data before adding new rows
            $('#exist_table').empty();

            if (res.dt && Array.isArray(res.dt.Table) && res.dt.Table.length > 0) {
    //alert(JSON.stringify(res.dt.Table, null, 2));
                res.dt.Table.forEach(function (item) {
                    const hasData =
                        (item.ticket && item.ticket !== "") ||
                        (item.type_name && item.type_name !== "") ||
                        (item.loan_no && item.loan_no !== "") ||
                        (item.customer_id && item.customer_id !== "");

                    // ✅ Append only rows that have at least one valid data cell
                    if (hasData) {
    //                     const comment = item.comments ? item.comments.replace(/'/g, "\\'") : '';  // Escape single quotes in comments
    // const attachment = item.attachments ? `'${item.attachments}'` : 'null';  // Wrap attachment in quotes or pass null

    $('#exist_table').append(`
        <tr>

            <td>T${item.ticket ? item.ticket : '-'}</td>
            <td>${item.type_name ? item.type_name : '-'}</td>
            <td>${item.loan_no ? item.loan_no : '-'}</td>
            <td>${item.customer_id ? item.customer_id : '-'}</td>
        </tr>
    `);


                        $('#text-msg').text('You Still Have Pending Grievance You Still Want to Proceed ?');
                                    $('#text-msg').append(`<div class="form-group" style="display:flex; gap:10px;">
        <button id="yes" type="button" class="btn btn-success">YES</button>
        <button type="button" id="no" class="btn btn-danger">NO</button>
    </div>`);
                    }
                });

                // ✅ If tbody has no rows after filtering → hide table & show complain box
                if ($('#exist_table').is(':empty')) {
                    $('.exists').hide();        // hide the table container
                    $('#complainBox').show();   // show fallback UI
                } else {
                    $('.exists').show();
                    $('#complainBox').hide();
                }

            } else {
                // ✅ No valid table data
                $('.exists').hide();
                $('#complainBox').hide();
            }
        },
        error: function () {
            $('.exists').hide();
            $('#complainBox').hide();
        }
    });


         

        $.ajax({
            url: API.allapi.Grievantstypes,
            method: "GET",
            data: { type: type },
            success: function (response) {
                $('#complainBox').show();
                console.log("Response:", response);

                if (response.success && response.grievanceTypes && response.grievanceTypes.length > 0) {
                    const select = $('#type');
                    select.empty(); // clear existing options
                    select.append('<option value="">- Select Type -</option>'); // default option
                     $('#typehead').text("Request Type");
                    
                    // loop through grievanceTypes array
                    response.grievanceTypes.forEach(item => {
                        select.append(`<option value="${item.type_id}" data-loan_type="${item.loan}">${item.type_name}</option>`);
                    });
                } else {
                         //$('#complainBox').show();
                    $('#type').html('<option value="">No types available</option>');
                }
            },
            error: function (xhr) {
                let msg = 'Error occurred';
                try {
                    const json = JSON.parse(xhr.responseText);
                    msg = json.Message || json.message || msg;
                } catch (e) {
                    msg = xhr.responseText || msg;
                }
                console.error(msg);
                $('#type').html('<option value="">Error loading types</option>');
            }
        });
    }

