        <div accesskey="" style="display: flex;
  width: 100%;
  justify-content: space-between;" class="mb-3">
            <div class="form-group">
                <label class="form-label mb-0  fw-semibold" style="text-align:center;">Customer Name</label>
                <p class="form-control-plaintext mb-0" id="customer_name" style="text-align:center;"> </p>
            </div>
            <div class="form-group">
                <label class="form-label mb-0  fw-semibold" style="text-align:center;">Customer Email</label>
                <p class="form-control-plaintext mb-0" id="customer_email" style="text-align:center;"> </p>
            </div>
            <div class="form-group">
                <label class="form-label mb-0  fw-semibold" style="text-align:center;">Customer Mobile</label>
                <p class="form-control-plaintext mb-0" id="customer_mobile" style="text-align:center;"> </p>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label mb-3  fw-semibold">Message Type</label>
            <br />
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="messageType" id="enquiry" value="2" onchange="cheking1()">
                <label class="form-check-label  fw-semibold" for="enquiry">Request</label>
            </div>

            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="messageType" id="complain" value="1" onchange="cheking2()">
                <label class="form-check-label  fw-semibold" for="complain">Greevants</label>
            </div>
        </div>

        <div class="exists" style="display:none">

            <table class="mb-3 border w-100 table table-bordered" >
                <thead >
                    <tr class="bg-light fw-semibold" id="exist-head">
                        @* <td>View Other Data</td> *@
                        <td>Ticket</td>
                        <td>Request Type</td>
                        <td>Loan Number</td>
                        <td>Customer ID</td>
                       
                    </tr>
                </thead>
                <tbody id="exist_table">
                </tbody>
            </table>
        <p id="text-msg" style="width:100%; display:flex; justify-content:space-between; "></p>
        </div>

        <!-- Hidden textarea, shown only if "Complain" is selected -->

        <div class="mb-3 " id="complainBox" style="display:none;">
            <label id="typehead" class="form-label mb-3  fw-semibold"></label>
            <select id="type" class="form-control mb-3">
                <option>
                    -Select Type-
                </option>
            </select>

            <table id="loanTableContainer" class="table table-bordered table-sm mb-3 "
                   style=" table-layout:auto; white-space:nowrap; margin:auto; ">
            </table>
            <div class="form-group mb-3" id="loan_no_sec" style="display:none;">
               
            </div>
            <partial name="attachments" />
            <label for="complainText" class="form-label mb-3  fw-semibold">Message</label>
            <textarea class="form-control" id="complainText" rows="4" placeholder="Describe your complaint..."></textarea>
        </div>

        <button class="btn btn-primary w-100">Submit</button>
    </form>
</section>


