  <script>
               $(window).on('load', function() {

                  $('.loader').fadeOut();
                  $('.loader-mask').delay(450).fadeOut('slow');
              });
               $.ajax({
            url: "/Loan-forall",
            method: "GET",
            success: function (response) {
                const data = response.data;
                data.forEach(loan => {

                   $('#services').append(`<li onclick="window.location.href='/services/${loan.loanname}/${loan.id}'" style="margin-top: 10px;">${loan.loanname}</li>`);
                  

                });
            },
            error: function () {
                alert('Failed to fetch loan data.');
            }
        });
  $('#auction_list').click(function(){
        $('#auction_list').addClass('active-page');
        $('#bidder_Select').removeClass('active-page');
        $('#biller_form').removeClass('active-page');
  });
    
     $('#bidder_Select').click(function(){
        $('#auction_list').removeClass('active-page');
        $('#bidder_Select').addClass('active-page');
        $('#biller_form').removeClass('active-page');
  });
      
     $('#biller_form').click(function(){
        $('#auction_list').removeClass('active-page');
        $('#bidder_Select').removeClass('active-page');
        $('#biller_form').addClass('active-page');
  });

  </script>

