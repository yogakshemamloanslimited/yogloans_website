  @RenderBody()
  <script>
  $('#auction_list').click(function(){
        $('#auction_list').addClass('active-page');
        $('#bidder_Select').removeClass('active-page');
        $('#biller_form').removeClass('active-page');
  });
    
     $('#bidder_Select').click(function(){
        $('#auction_list').removeClass('active-page');
        $('#bidder_Select').addClass('active-page');
        $('#biller_form').removeClass('active-page');
  });
      
     $('#biller_form').click(function(){
        $('#auction_list').removeClass('active-page');
        $('#bidder_Select').removeClass('active-page');
        $('#biller_form').addClass('active-page');
  });

  </script>
  <script>
            let timer;
            let logoutTime = 5 * 60 * 1000; // 2 minutes in milliseconds

            function resetTimer() {
                clearTimeout(timer);
                timer = setTimeout(() => {

                    window.location.href = "/Auction/Logout"; // Laravel logout route
                }, logoutTime);
            }

            // Track activity
            window.onload = resetTimer;
            document.onmousemove = resetTimer;
            document.onkeypress = resetTimer;
            document.onclick = resetTimer;
            document.onscroll = resetTimer;

            
        </script>
</body>
