  <style>
    *{
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    #auction_list.active-page{
        background-color: #044697;
        color: white;
        height: 30px;
        border-radius: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
    }
     #bidder_Select.active-page{
        background-color: #044697;
        color: white;
         height: 30px;
        border-radius: 10px;
           display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
    }
     #biller_form.active-page{
        background-color: #044697;
        color: white;
         height: 30px;
        border-radius: 10px;
           display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
    }
    ul li{
        list-style:none;
    }
  </style>
</head>
<body>
