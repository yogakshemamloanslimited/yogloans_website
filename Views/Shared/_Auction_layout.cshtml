">
      <i class="fas fa-bars"></i>
    </button>
      <img src="/images/logo/logo2.png" alt="" srcset="" id="logo" style=" height:50px;  margin-left:30px;">

     </div>
     
    <!-- Offcanvas Menu -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasMenu" style="width:250px;">
      <div class="offcanvas-header">
        
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
      </div>
      <div class="offcanvas-body">
                <ul class="list-unstyled" style="height: 100%; width: 100%; display: flex; flex-direction: column; justify-content: space-between; align-items: start;">
          <li onclick="window.location.href='/'"><i class="fas fa-home" style="margin-right: 40px;"></i> Home</li>
          <li onclick="window.location.href='/about'"><i class="fas fa-info-circle" style="margin-right: 40px;"></i> About</li>
         
                    <li >
            <a class="nav-link" data-bs-toggle="collapse" href="#services" role="button">
                            <i class="fas fa-cogs" style="margin-right: 40px !important;"></i> Services
            </a>
            <ul class="collapse" id="services">
            
            </ul>
          </li>
                    <li onclick="window.location.href='/investor'"><i class="fas fa-hand-holding-usd" style="margin-right: 40px;"></i> Investors</li>
                    <li onclick="window.location.href='/Onlineservices'"><i class="fas fa-globe" style="margin-right: 40px;"></i> Online Services</li>
                    <li onclick="window.location.href='/policies'"><i class="fas fa-file-alt" style="margin-right: 40px;"></i> Policies</li>
                    <li onclick="window.location.href='/career'"><i class="fas fa-briefcase" style="margin-right: 40px;"></i> Career</li>
                    <li onclick="window.location.href='/csr'"><i class="fas fa-leaf" style="margin-right: 40px;"></i> CSR</li>
                    <li onclick="window.location.href='/contact'"><i class="fas fa-envelope" style="margin-right: 40px;"></i> Contact Us</li>
        </ul>
      </div>
    </div>

@*     <div class="second-nav" style="width:100%; display:flex; margin-top:10px;">
        <div class="nav" style="width:100%; display:flex; justify-content:center;">
            <ul class="nav " style="width:40%; display:flex; flex-direction:row; justify-content: center; gap:50px; padding:10px;">
                <li style="width:auto;  padding:10px;  cursor:pointer;" class="active-page" id="auction_list">
