    <style>
        * {
            text-decoration: none !important;
        }

        /* ===== Fixed Hover Button Styles ===== */
        .activity {
            position: fixed;
            right: 0%;
            bottom: 2%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: end;
            width: auto;
            gap: 13px;
            z-index: 1000;
        }

        #service-items{
            color:black;
        }
        .au-redirection {
            position: relative;
            width: 60px;
            height: 50px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
            padding: 10px;
            text-align: center;
            overflow: hidden;
            border-top-left-radius: 40px;
            border-bottom-left-radius: 40px;
            transition: width 0.3s ease;
            z-index: 10;
        }

            .au-redirection i {
                color: white;
                z-index: 2;
                transition: color 0.3s ease;
            }

            .au-redirection p {
                font-size: 18px;
                margin: 0;
                text-align: center;
                display: none;
                color: white;
                z-index: 2;
            }

            .au-redirection::after {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                border-top-left-radius: 20px;
                border-bottom-left-radius: 20px;
                background-color: #044697;
                z-index: 1;
                transition: all 0.3s ease;
            }

            .au-redirection:hover {
                width: 200px;
                justify-content: space-between;
                padding: 0 15px;
            }

                .au-redirection:hover::after {
                    background-color: #B4181E;
                }

                


                .au-redirection:hover p {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    width: auto;
                }

        /* Animation keyframes (used elsewhere) */
        @@keyframes rotate {
            from

        {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }

        }

        .list-doc ul li, .card {
            cursor: pointer;
        }
        @@media(max-width:780px){
            .au-redirection i {
                font-size:18px;
            }
        }
    </style>
</head>

<body>

    @* gievance login model *@
    <input type="hidden" id="customer_id_getting" />
