<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - yogloans</title>

    <!-- Local styles -->
    <link rel="stylesheet" href="~/css/layout.css">
    <link rel="stylesheet" href="~/css/departments.css">
    <script src="~/js/site.js"></script>
    <script src="~/js/api.js"></script>

    <!-- External libs -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="icon" type="image/png" href="~/images/logo/logo.png" />

    <style>
        * {
            text-decoration: none !important;
        }

        /* ===== Fixed Hover Button Styles ===== */
        .activity {
            position: fixed;
            right: 0%;
            bottom: 2%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: end;
            width: auto;
            gap: 13px;
            z-index: 1000;
        }

        #service-items{
            color:black;
        }
        .au-redirection {
            position: relative;
            width: 60px;
            height: 50px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
            padding: 10px;
            text-align: center;
            overflow: hidden;
            border-top-left-radius: 40px;
            border-bottom-left-radius: 40px;
            transition: width 0.3s ease;
            z-index: 10;
        }

            .au-redirection i {
                color: white;
                z-index: 2;
                transition: color 0.3s ease;
            }

            .au-redirection p {
                font-size: 18px;
                margin: 0;
                text-align: center;
                display: none;
                color: white;
                z-index: 2;
            }

            .au-redirection::after {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                border-top-left-radius: 20px;
                border-bottom-left-radius: 20px;
                background-color: #044697;
                z-index: 1;
                transition: all 0.3s ease;
            }

            .au-redirection:hover {
                width: 200px;
                justify-content: space-between;
                padding: 0 15px;
            }

                .au-redirection:hover::after {
                    background-color: #B4181E;
                }

                


                .au-redirection:hover p {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    width: auto;
                }

        /* Animation keyframes (used elsewhere) */
        @@keyframes rotate {
            from

        {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }

        }

        .list-doc ul li, .card {
            cursor: pointer;
        }
    </style>
</head>

<body>
    <!-- LOADER -->
    <div class="loader-mask">
        <div class="loader">
            <div></div>
            <div></div>
        </div>
    </div>

    <!-- HEADER -->
    <header>
        <menu>
            <div class="menu-container">
                <img src="/images/logo/logo2.png" alt="" id="logo">
                <div class="toggle">
                    <img src="/images/icon/open-menu.png" alt="" id="menu" style="width: 35px !important;">
                </div>
                <ul>
                    <li onclick="window.location.href='/'">Home</li>
                    <li onclick="window.location.href='/about'">About</li>
                    <li class="services-link">Services</li>
                    <ul class="service-list" id="service-items"></ul>
                    <li onclick="window.location.href='/investor'">Investors</li>
                    <li onclick="window.location.href='/Onlineservices'">Online Services</li>
                    <li onclick="window.location.href='/policies'">Policies</li>
                    <li onclick="window.location.href='/career'">Career</li>
                    <li onclick="window.location.href='/csr'">CSR</li>
                    <li onclick="window.location.href='/contact'">Contact Us</li>
                </ul>
            </div>
        </menu>

        <menu id="res-menu" style="z-index: 400000;">
            <div class="menu-container">
                <ul>
                    <div class="toggle">
                        <img src="/images/icon/arrow(1).png" alt="" id="close">
                    </div>
                    <li onclick="window.location.href='/'"><i class="fas fa-home" style="margin-right: 40px;"></i> Home</li>
                    <li onclick="window.location.href='/about'"><i class="fas fa-info-circle" style="margin-right: 40px;"></i> About</li>
                    <li class="services-link2"><i class="fas fa-cogs" style="margin-right: 40px;"></i> Services</li>
                    <ul class="service-list2" id="service-items2" style="overflow:visible;"></ul>
                    <li onclick="window.location.href='/investor'"><i class="fas fa-hand-holding-usd" style="margin-right: 40px;"></i> Investors</li>
                    <li onclick="window.location.href='/Onlineservices'"><i class="fas fa-globe" style="margin-right: 40px;"></i> Online Services</li>
                    <li onclick="window.location.href='/policies'"><i class="fas fa-file-alt" style="margin-right: 40px;"></i> Policies</li>
                    <li onclick="window.location.href='/career'"><i class="fas fa-briefcase" style="margin-right: 40px;"></i> Career</li>
                    <li onclick="window.location.href='/csr'"><i class="fas fa-leaf" style="margin-right: 40px;"></i> CSR</li>
                    <li onclick="window.location.href='/contact'"><i class="fas fa-envelope" style="margin-right: 40px;"></i> Contact Us</li>
                </ul>
                <div class="contact">
                    <div class="icons" style="width: 100%; display: flex; justify-content:space-between;">
                        <a href="https://www.facebook.com/share/18qcUVv3fJ/?mibextid=wwXIfr" target="_blank"><i class="fab fa-facebook-f" style="color: black; font-size:15px;"></i></a>
                        <a href="https://www.instagram.com/yogloansfinance?igsh=djhqZGI0dG92bGI0" target="_blank"><i class="fab fa-instagram" style="color: black; font-size:15px;"></i></a>
                        <a href="https://www.linkedin.com/company/yogloans" target="_blank"><i class="fab fa-linkedin-in" style="color: black; font-size:15px;"></i></a>
                    </div>
                </div>
            </div>
        </menu>
    </header>

    <!-- MAIN BODY -->
    @RenderBody()

    <!-- Floating Hover Buttons -->
    <div class="activity">
        <a href="/Auction" class="au-redirection">
            <i class="fas fa-gavel"></i>
            <p>Auction</p>
        </a>
        <a href="/Grievance" class="au-redirection">
            <i class="fas fa-user"></i>
            <p>Grievances</p>
        </a>
    </div>

    <!-- FOOTER -->
    <footer class="footer-section">
        <div class="container">
            <div class="footer-content">
                <div class="row">
                    <div class="col-xl-4 col-lg-4 mb-50">
                        <div class="footer-widget" style="text-align:justify;">
                            <div class="footer-text">
                                <p>
                                    To emerge as the most trusted financial solution provider in India, with special
                                    focus on emerging segments of society, through a nationwide, efficient and service
                                    oriented network.
                                </p>
                            </div>
                            <div class="footer-social-icon">
                                <span>Follow us</span>
                                <a href="https://www.facebook.com/share/18qcUVv3fJ/?mibextid=wwXIfr" target="_blank"><img src="/images/icon/facebook.png" alt=""></a>
                                <a href="https://www.instagram.com/yogloansfinance?igsh=djhqZGI0dG92bGI0" target="_blank"><img src="/images/icon/social-media.png" alt=""></a>
                                <a href="https://www.linkedin.com/company/yogloans" target="_blank"><img src="/images/icon/linkedin-logo.png" alt=""></a>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-6 mb-30">
                        <div class="footer-widget">
                            <div class="footer-widget-heading"><h3>Useful Links</h3></div>
                            <ul style="padding-left: 0;">
                                <li><a href="/">Home</a></li>
                                <li><a href="/about">About Us</a></li>
                                <li><a href="/investor">Investors</a></li>
                                <li><a href="/Onlineservices">Online Services</a></li>
                                <li><a href="/policies">Policies</a></li>
                                <li><a href="/csr">CSR</a></li>
                                <li><a href="/career">Career</a></li>
                                <li><a href="/contact">Contact Us</a></li>
                                <li><a href="/gallery">Gallery</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-6 mb-50">
                        <div class="footer-widget">
                            <div class="footer-widget-heading"><h3>Subscribe</h3></div>
                            <div class="footer-text mb-25"><p>Don't miss to subscribe to our new feeds</p></div>
                            <div id="subscribe-success" style="display: none; color: green; margin-top: 10px;">🎉 Thank you for subscribing!</div>
                            <div class="subscribe-form">
                                <form id="subscribe-form">
                                    <input type="email" id="email-input" placeholder="Email Address" required>
                                    <button type="submit"><img src="/images/icon/send.png" alt=""></button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="copyright-area">
            <div class="container">
                <div class="" style="width:100%; display:flex; justify-content:center; align-items:center;">
                    <div class="col-xl-6 text-center text-lg-left">
                        <p>2025 YOGAKSHEMAM LOANS Ltd. All rights reserved.</p>
                    </div>
                    <div class="col-xl-8 text-right d-none d-lg-block">
                        <ul id="footer-menu" style="list-style:none; display:flex; justify-content:space-between;"></ul>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Your JS logic kept same as before (AJAX, owl, menu, etc.)
        $.ajax({
            url: "/Loan-forall",
            method: "GET",
            success: function (response) {
                const data = response.data;
                data.forEach(loan => {
                    $('#service-items2').append(`<li onclick="window.location.href='/services/${loan.loanname}/${loan.id}'" style="display:flex; justify-content:space-between;"><img src="${loan.icon}" style="width:17px; height:18px;"/>${loan.loanname}</li>`);
                    $('#service-items').append(`<li onclick="window.location.href='/services/${loan.loanname}/${loan.id}'" style="display:flex; justify-content:space-between; color:black;"><img src="${loan.icon}" style="width:17px; height:18px;"/>${loan.loanname}</li>`);
                    $('#footer-menu').append(`<li onclick="window.location.href='/services/${loan.loanname}/${loan.id}'" style="color:white; cursor:pointer;"><img src="${loan.icon}" style="width:20px; height:20px; filter:invert(1);"/> ${loan.loanname}</li>`);
                });
            },
            error: function () {
                alert('Failed to fetch loan data.');
            }
        });

        // Responsive menu
        document.getElementById('menu').onclick = () => document.getElementById('res-menu').style.width = '60%';
        document.getElementById('close').onclick = () => document.getElementById('res-menu').style.width = '0%';

        // Subscribe form
        document.getElementById("subscribe-form").addEventListener("submit", function(e) {
            e.preventDefault();
            var email = document.getElementById("email-input").value;
            $.ajax({
                url: 'http://localhost:8085/api/NewsLetter/post?email=' + encodeURIComponent(email),
                method: 'POST',
                success: function() {
                    document.getElementById("subscribe-success").style.display = "block";
                    document.getElementById("email-input").value = "";
                },
                error: function() {
                    alert('Subscription failed. Please try again.');
                }
            });
        });

        // Loader
                   $(window).on('load', function() {
            // If loan page sets __keepLoader__, skip hiding
            if (window.__keepLoader__) return;

            $('.loader').fadeOut();
            $('.loader-mask').delay(450).fadeOut('slow');
        });


               $(window).on('scroll', function() {
          // check how far the user has scrolled
          if ($(this).scrollTop() > 50) {
            $('.menu-container').css('background', '#B4181E');
          } else {
            $('.menu-container').css('background', 'transparent');
          }
        });

    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/jaquery.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
