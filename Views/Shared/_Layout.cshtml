                                <span class="text-danger"></span>
                            </div>

                            <div class="form-group" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; margin-top: 10px;">
                                <button class="btn btn-primary" id="verifyOtpBtn">
