    @* grievance login script start *@
    <script>
        $(document).ready(function () {

			$('#gievancepopup-form').on('click', function () {
				$('#grievancemodel').modal('show');
			
				$('#otpSection').hide();
				$('#sendOtpBtn').show();
				$('#mobileNo').val('');
				$('#otpInput').val('');
			});

            function extractErrorMessage(xhr) {
                let msg = 'Error occurred';
                try {
                    const json = JSON.parse(xhr.responseText);
                    msg = json.Message || json.message || msg;
                } catch (e) {
                    msg = xhr.responseText || msg;
                }
                return msg.replace(/[{}"]/g, '').trim(); // remove {} and quotes if any remain
            }

            // ====================== SEND OTP ======================
            $('#sendOtpBtn').on('click', function (e) {
                e.preventDefault();

                const mobile = $('#mobileNo').val();
                $('#taxFormMsg').text('');
                $('#send-img').hide();
                $('#spin-load').show();

                $.ajax({
                    url: API.allapi.Sendotp + '?mobile=' + encodeURIComponent(mobile),
                    type: 'GET',
                    success: function (res) {

                        if (res.success) {
                            slNo = res.slNo;
                            $('#customer_id_getting').val(res.customerId || '');
                            $('#otpSection').show();
                            $('#sendOtpBtn').hide();
                            $('#taxFormMsg').text(res.message).css('color', 'green');
                        } else {
                            $('#taxFormMsg').text(res.message || 'Failed to send OTP').css('color', 'red');
                        }
                        $('#spin-load').hide();
                    },
                    error: function (xhr) {
                        const msg = extractErrorMessage(xhr);
                        $('#taxFormMsg').text(msg).css('color', 'red');
                        $('#spin-load').hide();
                    }
                });
            });

            // ====================== VERIFY OTP ======================
            $('#verifyOtpBtn').on('click', function (e) {
                e.preventDefault();

                const customerId = $('#customer_id_getting').val();
                const mobileNo = $('#mobileNo').val();
                const otp = $('#otpInput').val();

                $('#spin-very-load').show();

                if (!slNo) {
                    $('#taxFormMsg').text('Session expired. Please try again.').css('color', 'red');
                    $('#spin-very-load').hide();
                    return;
                }

                $.ajax({
                    url: API.allapi.verifyotp,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ CustomerId: customerId, MobileNo: mobileNo, Otp: otp, SlNo: slNo }),
                    success: function (res) {
                        if (!res) {
                            $('#taxFormMsg').text('No data returned from server.').css('color', 'red');
                            $('#spin-very-load').hide();
                            return;
                        }

                        if (res.success) {
                            $.ajax({
                                url: '@Url.Action("Customeraddress", "Home")',
                                type: 'POST',
                                data: {
                                    address: null,
                                    CustomerId: customerId
                                },
                                success: function (response) {
                                    console.log("Session set response:", response);

                                    if (response.success) {
                                        setTimeout(() => {
                                            window.location.href = `/Grievance`;
                                        }, 300);
                                    } else {
                                        console.warn("Session not set:", response.message);
                                    }
                                },
                                error: function (xhr) {
                                    const msg = extractErrorMessage(xhr);
                                    console.error("Session set failed:", msg);
                                }
                            });

                            $('#taxFormMsg').text(res.message).css('color', 'green');
                        } else {
                            $('#taxFormMsg').text('OTP verification failed').css('color', 'red');
                        }

                        $('#spin-very-load').hide();
                    },
                    error: function (xhr) {
                        const msg = extractErrorMessage(xhr);
                        $('#taxFormMsg').text(msg).css('color', 'red');
                        $('#spin-very-load').hide();
                    }
                });
            });

            // ====================== RESEND OTP ======================
            $('#resendOtpBtn').on('click', function (e) {
                e.preventDefault();

                const customerId = $('#customer_id_getting').val();
                const mobileNo = $('#mobileNo').val();

                if (!slNo) {
                    $('#taxFormMsg').text('Session expired. Please try again.').css('color', 'red');
                    return;
                }

                $.ajax({
                    url: API.allapi.resendOtp,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ CustomerId: customerId, MobileNo: mobileNo, SlNo: slNo }),
                    success: function (res) {
                        if (res.success) {
                            $('#taxFormMsg').text(res.message).css('color', 'green');
                        } else {
                            $('#taxFormMsg').text(res.message || 'Failed to resend OTP').css('color', 'red');
                        }
                    },
                    error: function (xhr) {
                        const msg = extractErrorMessage(xhr);
                        $('#taxFormMsg').text(msg).css('color', 'red');
                    }
                });
            });

        });
    </script>
    @* grievance login script end *@

    @* Auction login script *@

    <script>
        $(document).ready(function () {
                   $('#auction-model-show').on('click', function() {
            $('#auctionmodel').modal('show');
        });

                  
            $('#logme').click(function() {
                var mobile = $('#mobile').val();
                var otp = $('#otp').val();

                $.ajax({
                    url: "http://localhost:8085/api/auction/login?mobile=" + mobile + "&otp=" + otp,
                    method: "GET",
                    success: function (response) {
                        let codeValue = 0; // default

                        if (response.outputMessage === "1") {
                            codeValue = 1;
                        }
                        else if (response.outputMessage === "2") {
                            codeValue = 2;
                        }
                        else {
                            codeValue = 0;
                        }

                        // Set the session via POST
                        $.ajax({
                            url: '@Url.Action("SetModuleId", "Home")',
                            method: 'POST',
                           data: { code: codeValue, mobile: mobile, otp: otp },

                            success: function () {
                                // After setting session, take action based on outputMessage
                                if (response.outputMessage === "1") {
                                    window.location.href = '/Auction';
                                }
                                else if (response.outputMessage === "2") {
                                                     window.location.href = '/Auctineer';
                                }
                                else {
                                    $('#errorMessage').text(response.outputMessage);

                                    var errorModal = new bootstrap.Modal(document.getElementById('errorModal'), {
                                        backdrop: 'static',
                                        keyboard: false
                                    });
                                    errorModal.show();
                                }
                            },
                            error: function () {
                                alert('Failed to set session.');
                            }
                        });
                    },
                    error: function (xhr, status, error) {
                        console.error(error);
                        alert("An error occurred: " + error);
                    }
                });
            });
        });


    </script>
    @* Auction login script end *@
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/jaquery.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
