                    <button type="button" class="btn-close" data-bs-dismiss="modal" id="close-btn3"></button>
                </div>
                <div class="modal-body">
                    <span id="taxFormMsg3" class="mt-2"></span>
                    <form class="login">
                        <p id="taxFormMsg" style="color:black;">We’re Here to Help</p>

                        <!-- Mobile Number Input -->
                        <div class="form-group" style="display: flex; align-items: center; justify-content: center;  margin-bottom: 10px;">
                            <img src="~/images/icon/dialpad.png" style="width:20px; height:20px; margin-right: 10px;" />
