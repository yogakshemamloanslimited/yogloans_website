<script>
          let currentTransactionId = null;
    let paymentTimeoutTimer = null;
    let qrCountdownTimer = null;

    // Draw QR image
    function drawQRCode(base64Image) {
        const canvas = document.getElementById("qrCanvas");
        const ctx = canvas.getContext("2d");
        const img = new Image();
        img.onload = () => {
            canvas.width = img.width;
            canvas.height = img.height;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        };
        img.src = base64Image;
    }

    // Reset QR and transaction
    function resetQRCode() {
        const canvas = document.getElementById("qrCanvas");
        const ctx = canvas.getContext("2d");
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        currentTransactionId = null;

        // Stop countdown
        if (qrCountdownTimer) clearInterval(qrCountdownTimer);
        document.getElementById("qrTimer").textContent = "00:00";

        // Close modal
        const qrModalEl = document.getElementById('qrModal');
        const qrModal = bootstrap.Modal.getInstance(qrModalEl);
        if (qrModal) qrModal.hide();

        console.log("QR Code and transaction reset after 2 minutes.");
    }

    // Start countdown timer
    function startQrTimer(durationSeconds) {
        let remaining = durationSeconds;
        const timerEl = document.getElementById("qrTimer");

        // Clear previous interval if exists
        if (qrCountdownTimer) clearInterval(qrCountdownTimer);

        qrCountdownTimer = setInterval(() => {
            const minutes = String(Math.floor(remaining / 60)).padStart(2, "0");
            const seconds = String(remaining % 60).padStart(2, "0");
            timerEl.textContent = `${minutes}:${seconds}`;

            remaining--;

            if (remaining < 0) {
                clearInterval(qrCountdownTimer);
            }
        }, 1000);
    }

    // Generate QR code and show modal
    async function generateQRCode(button) {
    const btn = $(button);
    const loanno = btn.data('loan'); // ✅ matches data-loan
   
       // Clear button and show spinner
       btn.empty();
       btn.html(' <i class="fa fa-spinner fa-spin"></i>');
       btn.prop('disabled', true);
        const sessionaddress = '@Context.Session.GetString("Customeraddress")';
        const part = sessionaddress.split('$').map(p => p.trim());
        const customername = part[0] || "Unknown";

        //Swal.fire({ title: "Generating QR Code...", didOpen: () => Swal.showLoading() });

        try {
            const res = await fetch(`/Generateqrcode/GenerateQRCode?loanno=${encodeURIComponent(loanno)}&customername=${encodeURIComponent(customername)}`);
            const data = await res.json();

            Swal.close();

            drawQRCode(data.qrImage);

            // Show modal
            const qrModal = new bootstrap.Modal(document.getElementById('qrModal'), {
                backdrop: 'static',  // Prevent clicking outside
                keyboard: false      // Prevent Esc key
            });
            qrModal.show();

            // Save current transaction
            currentTransactionId = data.transactionId;

            // Start countdown timer (2 minutes = 120 seconds)
            startQrTimer(120);
            btn.empty();
       btn.html('<i class="fa fa-qrcode" aria-hidden="true"></i>');
       btn.prop('disabled', false);
            // Reset QR after 2 minutes
            if (paymentTimeoutTimer) clearTimeout(paymentTimeoutTimer);
            paymentTimeoutTimer = setTimeout(resetQRCode, 120000);

        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to generate QR code.' });
            console.error(err);
        }
    }
            // transaction
     function viewtransaction(button) {
            $('#content-loader').show();
                   const area = $('#statements-area')[0];

    area.scrollIntoView({ behavior: 'smooth', block: 'center' });

    // Delay focus slightly
    setTimeout(() => {
      $('#statements-area').focus();
    }, 500);

          const btn = $(button);
        const loanno = btn.data('loan');
        const loancat = btn.data('loancat');
        const table = $('#transactionTable');
        const filterSelect = $('#filterRange');

        btn.html('<i class="fa fa-spinner fa-spin"></i>');
        btn.prop('disabled', true);

        $.ajax({
            url: API.allapi.Gettrans,
            method: "GET",
            data: { loan_no: loanno, loan_cat: loancat },
            success: function(res) {
               $('#content-loader').hide();
                let allData = res.data || [];
                let filteredData = [...allData]; // keep latest filtered dataset
                 $('#statements-area').show();
                // ✅ Render Table
                function renderTable(data) {
                    table.empty();
                    table.append(`
                        <tr>
                            <th>SNo</th>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Debit</th>
                            <th>Credit</th>
                            <th>Balance</th>
                        </tr>
                    `);

                    if (data.length === 0) {
                        table.append(`<tr><td colspan="6" class="text-center text-muted">No records found</td></tr>`);
                    } else {
                       
                        data.forEach(item => {
                            table.append(`
                                <tr>
                                    <td>${item.SNo}</td>
                                    <td>${item.Date}</td>
                                    <td>${item.Description}</td>
                                    <td>${item.Debit}</td>
                                    <td>${item.Credit}</td>
                                    <td>${item.Balance}</td>
                                </tr>
                            `);
                        });
                    }
                }

                // ✅ Filter Function
                function filterData(range) {
                    const now = new Date();
                    let fromDate;

                    switch (range) {
                        case '1d': fromDate = new Date(); fromDate.setDate(now.getDate() - 1); break;
                        case '1w': fromDate = new Date(); fromDate.setDate(now.getDate() - 7); break;
                        case '1m': fromDate = new Date(); fromDate.setMonth(now.getMonth() - 1); break;
                        case '1y': fromDate = new Date(); fromDate.setFullYear(now.getFullYear() - 1); break;
                        default: return allData;
                    }

                    return allData.filter(item => {
                        const d = new Date(item.Date);
                        return d >= fromDate && d <= now;
                    });
                }

                // Initial render
                renderTable(allData);

                // Filter change event
                filterSelect.off('change').on('change', function() {
                    const range = $(this).val();
                    filteredData = filterData(range);
                    renderTable(filteredData);
                });

                // ✅ Download Excel
    //                  $('#downloadExcel').off('click').on('click', function() {
    //     if (typeof XLSX === 'undefined') {
    //         alert("Excel export library not loaded yet!");
    //         return;
    //     }
    //     if (filteredData.length === 0) return alert("No data to export!");
    //     const ws = XLSX.utils.json_to_sheet(filteredData);
    //     const wb = XLSX.utils.book_new();
    //     XLSX.utils.book_append_sheet(wb, ws, "Transactions");
    //     XLSX.writeFile(wb, "Transaction_Report.xlsx");
    // });

                // ✅ Download PDF
                $('#downloadPDF').off('click').on('click', function() {
                    if (filteredData.length === 0) return alert("No data to export!");
                    const { jsPDF } = window.jspdf;
                    const doc = new jsPDF();

                    doc.text("Transaction Report", 14, 15);
                    doc.autoTable({
                        head: [['SNo', 'Date', 'Description', 'Debit', 'Credit', 'Balance']],
                        body: filteredData.map(item => [
                            item.SNo, item.Date, item.Description, item.Debit, item.Credit, item.Balance
                        ]),
                        startY: 20,
                        styles: { fontSize: 9 }
                    });

                    doc.save("Transaction_Report.pdf");
                });

                btn.html('<i class="fa fa-file-text" aria-hidden="true"></i>');
                btn.prop('disabled', false);
            },
            error: function() {
                alert("Error loading transactions!");
                btn.html('<i class="fa fa-file-text" aria-hidden="true"></i>');
                btn.prop('disabled', false);
            }
        });
    }


</script>

