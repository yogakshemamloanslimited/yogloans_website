 $(document).ready(function () {
    
       let loanno = null;
const customerId = '@Context.Session.GetString("CustomerId")';

const url = API.allapi.Payonline + encodeURIComponent(customerId) +'/' + 
              encodeURIComponent(loanno);

$.ajax({
    url: url,
    method: 'GET',
    dataType: 'json',
    success: function (response) {
        const loans = response.customer_data || [];

        if (loans.length === 0) {
            $('#result').html('<div class="alert alert-warning mt-3">No loan records found.</div>');
            return;
        }

        let tableHTML = `
        <div class="table-responsive" style="width:100%;">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Loan No</th>
                        <th>Product</th>
                        <th>Due Amount (₹)</th>
                        <th>Other Charges (₹)</th>
                        <th>Transaction Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
        `;

        loans.forEach(item => {
            tableHTML += `
                <tr>
                    <td>${item.loan_no}</td>
                    <td>${item.product}</td>
                    <td>${item.due_amount.toLocaleString('en-IN')}</td>
                    <td>${item.other_charges.toLocaleString('en-IN')}</td>
                    <td>${new Date(item.trans_date).toLocaleDateString('en-IN')}</td>
                    <td>
                            <button class="btn btn-sm btn-primary"
                            onclick="generateQRCode('${item.loan_no}')">
                           Generate QR Code <i class="fa fa-qrcode" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>
            `;
        });

        tableHTML += `
                </tbody>
            </table>
        </div>`;

        $('#result').html(tableHTML);
    },
    error: function (xhr, status, error) {
        console.error('Error fetching loan details:', error);
        $('#field_error')
            .text('Error fetching loan details. Please try again later.')
            .css('color', 'red');
    }
});

  
    });

   
