                    <tr>
                        <th>Loan No</th>
                        <th>Product</th>
                        <th>Due Amount (₹)</th>
                        <th>Other Charges (₹)</th>
                        <th>Transaction Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
        `;

        loans.forEach(item => {
            tableHTML += `
                    <tr>
      <td>${item.loan_no}</td>
      <td>${item.product}</td>
      <td>${item.due_amount.toLocaleString('en-IN')}</td>
