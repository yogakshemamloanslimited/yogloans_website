 @model List<yogloansdotnet.Models.OnlineWelcome>

@{
    ViewData["Title"] = "Payment Success";
}

<link rel="stylesheet" href="~/css/home/welcome.css" asp-append-version="true">
@{
    var firstWelcome = Model?.FirstOrDefault();
}
<section class="welcome-container"
         style="background-image: url(@(firstWelcome.Image1 != null ? "data:image/png;base64," + Convert.ToBase64String(firstWelcome.Image1) : ""))" id="welcome-desktop">
    <h1 style="visibility:hidden;">
        Payment Success
    </h1><!--    <p id="sub">Experience Door Step Gold Loan Services</p>  -->
    <div class="button">
        <h1>
            Payment Success
        </h1>
        @* <p><a href="javascript:history.back()" id="return-link">Home</a>- Online Services</p> *@
    </div>

</section>



<section class="welcome-container"
         style="background-image: url(@(firstWelcome.Image2 != null ? "data:image/png;base64," + Convert.ToBase64String(firstWelcome.Image2) : ""))" id="welcome-mobile">
    <h1 style="visibility:hidden;">
        Payment Success
    </h1><!--    <p id="sub">Experience Door Step Gold Loan Services</p>  -->
    <div class="button">
        <h1>
            Payment Success
        </h1>
        @*  <p><a href="javascript:history.back()" id="return-link">Home</a> - Online Services</p> *@
    </div>
</section>
<section>
    <div class="details">
        <div class="header">
            <h2 style="text-align: center; color: #28a745;">Success!</h2>
            <p style="text-align: center; font-weight: bold; color: #28a745; width: 100%;">Payment Completed Successfully</p>
            <img src="~/images/HappyMan.jpg" alt="Happy person illustration" style="display: block; margin: 0 auto; max-width: 200px;" />
            <p style="text-align: center;">Thank you for your payment. Your transaction has been processed successfully.</p>
            <div style="text-align: center; margin-top: 20px;">
                <a href="/Onlineservices" style="padding: 10px 20px; background-color: #28a745; color: white; text-decoration: none; border-radius: 4px;">Go to Dashboard</a>
            </div>
        </div>
    </div>
</section>



<style>
    .welcome-container {
        height: 300px;
    }

    a {
        text-decoration: none;
        color: white;
    }

    #welcome-mobile {
        display: none;
    }

    #welcome-desktop {
        display: flex;
    }

    @@media (max-width: 767px) {
        #welcome-desktop {
            display: none;
        }

        #welcome-mobile {
            display: flex;
        }
    }
</style>