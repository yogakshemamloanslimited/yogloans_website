}
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<link rel="stylesheet" href="~/css/home/welcome.css" asp-append-version="true">
<partial name="Welcome" />
